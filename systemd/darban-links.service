[Unit]
Description=Darban OVPN temporary profile links
# Started only while a link exists; the program ends by itself when the last one is gone. While port-share is on,
# it listens on 127.0.0.1 only, OpenVPN hands it what is not OpenVPN on its TCP port, and it stays up: darban enables
# it then, and a drop-in starts it again when it fails. LINK_EXTRA holds those arguments, and nothing otherwise.

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/darban/links.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/darban/linkd.py --dir /run/darban-links --cert /etc/darban/link-cert.pem --key /etc/darban/link-key.pem --host ${LINK_HOST} --port ${LINK_PORT} $LINK_EXTRA
# A new certificate reaches new connections; a download in progress finishes.
ExecReload=/bin/kill -HUP $MAINPID
Restart=no
UMask=0077
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/darban-links
# What this service does not need is not there for it: OpenVPN's keys and server.conf, other certificates, the CA
# backups, the journal of this tool, the connection events, password hashes, and OpenVPN's management interface,
# which takes commands. Without server.conf it never asks that interface; the five-minute check does, as root.
# The SSH host keys too, which would let someone pose as this server, other private keys under /etc/ssl/private,
# and the logs, the system journal among them, which hold the same client names as the journal of this tool.
InaccessiblePaths=-/etc/openvpn -/etc/letsencrypt -/var/backups/darban-pki -/var/lib/darban -/run/darban-events -/run/openvpn-server -/etc/shadow -/etc/gshadow -/etc/ssh -/etc/ssl/private -/var/log
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# No unix sockets, so no management interface either, wherever it is.
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# Only the system calls of an ordinary service. One outside them fails with EPERM instead of killing the service.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
