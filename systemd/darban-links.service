[Unit]
Description=Darban OVPN temporary profile links
# Started only while a link exists; the program ends by itself when the last one is gone.

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/darban/links.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/darban/linkd.py --dir /run/darban-links --cert /etc/darban/link-cert.pem --key /etc/darban/link-key.pem --host ${LINK_HOST} --port ${LINK_PORT}
# A new certificate reaches new connections; a download in progress finishes.
ExecReload=/bin/kill -HUP $MAINPID
Restart=no
UMask=0077
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/darban-links
# What this service does not need is not there for it: OpenVPN's keys and server.conf, other certificates, the CA
# backups, the journal of this tool, the connection events, password hashes, and OpenVPN's management interface,
# which takes commands. Without server.conf it never asks that interface; the five-minute check does, as root.
InaccessiblePaths=-/etc/openvpn -/etc/letsencrypt -/var/backups/darban-pki -/var/lib/darban -/run/darban-events -/run/openvpn-server -/etc/shadow -/etc/gshadow
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# No unix sockets, so no management interface either, wherever it is.
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
