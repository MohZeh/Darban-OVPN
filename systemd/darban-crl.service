[Unit]
Description=Darban OVPN automatic CRL renewal
# No ConditionPathExists: a missing server.conf must fail loudly, not be skipped silently.

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/darban-crl-maintain --auto
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
# Easy-RSA PKI, published CRL, and the shared lock file.
ReadWritePaths=/root/pki /etc/openvpn/server /run
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
