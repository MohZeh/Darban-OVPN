[Unit]
Description=Darban OVPN daily backup of the CA, when something changed
# Started by darban-crl.service when its daily check succeeds, so it has no [Install].

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/darban backup-auto daily
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
# The backups, and the shared lock. The CA and the settings are only read.
ReadWritePaths=-/var/backups /run
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
