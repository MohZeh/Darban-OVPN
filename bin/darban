#!/usr/bin/env bash
# Darban OVPN: the manager of an OpenVPN 2.7 and Easy-RSA 3 server.
set -Eeuo pipefail
umask 077
source /usr/local/lib/darban/common.sh
source /usr/local/lib/darban/ui.sh

DARBAN_VERSION=1.0.1
# One fixed order, by absolute path: the paths first, then the configuration and the other parts of the manager,
# then its screens. scripts/check-modules.py checks this order.
# shellcheck source=lib/darban/paths.sh
source /usr/local/lib/darban/modules/paths.sh
# shellcheck source=lib/darban/config.sh
source /usr/local/lib/darban/modules/config.sh
# shellcheck source=lib/darban/core.sh
source /usr/local/lib/darban/modules/core.sh
# shellcheck source=lib/darban/clients.sh
source /usr/local/lib/darban/modules/clients.sh
# shellcheck source=lib/darban/shares.sh
source /usr/local/lib/darban/modules/shares.sh
# shellcheck source=lib/darban/links.sh
source /usr/local/lib/darban/modules/links.sh
# shellcheck source=lib/darban/certs.sh
source /usr/local/lib/darban/modules/certs.sh
# shellcheck source=lib/darban/pki.sh
source /usr/local/lib/darban/modules/pki.sh
# shellcheck source=lib/darban/sessions.sh
source /usr/local/lib/darban/modules/sessions.sh
# shellcheck source=lib/darban/events.sh
source /usr/local/lib/darban/modules/events.sh
# shellcheck source=lib/darban/network.sh
source /usr/local/lib/darban/modules/network.sh
# shellcheck source=lib/darban/settings.sh
source /usr/local/lib/darban/modules/settings.sh
# shellcheck source=lib/darban/tool.sh
source /usr/local/lib/darban/modules/tool.sh
# shellcheck source=lib/darban/health.sh
source /usr/local/lib/darban/modules/health.sh
# shellcheck source=lib/darban/blocked.sh
source /usr/local/lib/darban/modules/blocked.sh
# shellcheck source=lib/darban/dns.sh
source /usr/local/lib/darban/modules/dns.sh
# shellcheck source=lib/darban/names.sh
source /usr/local/lib/darban/modules/names.sh
# shellcheck source=lib/darban/backup.sh
source /usr/local/lib/darban/modules/backup.sh
# shellcheck source=lib/darban/restore.sh
source /usr/local/lib/darban/modules/restore.sh
# shellcheck source=lib/darban/screens/frame.sh
source /usr/local/lib/darban/modules/screens/frame.sh
# shellcheck source=lib/darban/screens/clients.sh
source /usr/local/lib/darban/modules/screens/clients.sh
# shellcheck source=lib/darban/screens/main.sh
source /usr/local/lib/darban/modules/screens/main.sh
# shellcheck source=lib/darban/screens/settings.sh
source /usr/local/lib/darban/modules/screens/settings.sh
# shellcheck source=lib/darban/screens/maintenance.sh
source /usr/local/lib/darban/modules/screens/maintenance.sh

usage() {
    cat <<EOF
Darban OVPN v$DARBAN_VERSION

Usage: darban [--no-clear] [COMMAND]

Commands:
  (none)     interactive menu
  list       print the client table; --all includes revoked clients
  status     print the diagnostics checklist
  repair-crl publish a fresh CRL and finish an interrupted revocation
  connected  list the clients connected right now
  update     check for a new release and install it
  enable-events turn on connection events, with one OpenVPN restart (the installer does this)
  welcome    show the next steps of a new server
  about      show the version, project address and contact
  uninstall  remove this tool; OpenVPN, the PKI and the CRL are kept
  remove-all remove this tool, OpenVPN, the CA and all profiles (only after server-setup)
  restore    restore the CA from an opened backup: restore <file.tar> --ca-fingerprint <SHA-256>
             (or --ca-from <profile.ovpn>); --resume or --rollback a restore that stopped; --acknowledge
  version    print the version
  help       show this help

Options:
  --no-clear never clear the screen

Environment: NO_COLOR=1 disables colors. Actions are logged: journalctl -t darban

Project: $DARBAN_URL
Contact: $DARBAN_EMAIL
EOF
}
main() {
    local cmd=''
    while (( $# )); do
        case $1 in
            --no-clear) UI_CLEAR=0 ;;
            --all) LIST_ALL=1 ;;
            -h|--help|help) usage; exit 0 ;;
            -V|--version|version) printf '%s\n' "$DARBAN_VERSION"; exit 0 ;;
            about) about_text; exit 0 ;;
            # For certbot's deploy hook only; it needs nothing else from the tool.
            reload-links) reload_links_now; exit $? ;;
            # For systemd only: the daily backup of the CA, after the CRL check.
            backup-auto)
                darban_require_root || exit 1
                load_config
                run_action backup_command "${2:-daily}"
                exit "$ACTION_RC" ;;
            # For systemd only: the daily update of the lists of countries, for Settings > Blocked destinations.
            geo-update)
                darban_require_root || exit 1
                load_config
                run_action geo_daily
                exit "$ACTION_RC" ;;
            # It takes the rest of the line as its own.
            restore) cmd=restore; shift; RESTORE_ARGS=("$@"); break ;;
            # For systemd only: the jobs of connection events, which need nothing of the menu.
            events|sweep|events-setup)
                darban_require_root || exit 1
                # The hours of Settings and the SSH user, for the files kept on the server.
                load_config
                case $1 in events) run_action events_worker ;; sweep) run_action sweep ;; *) run_action events_setup ;; esac
                exit "$ACTION_RC" ;;
            list|status|repair-crl|connected|update|uninstall|remove-all|welcome|enable-events) [[ -z $cmd ]] || { usage >&2; exit 2; }; cmd=$1 ;;
            *) printf 'Unknown argument: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
        esac
        shift
    done
    if (( LIST_ALL )) && [[ $cmd != list ]]; then printf -- '--all only works with list.\n\n' >&2; usage >&2; exit 2; fi
    ui_init
    setup
    # A restore that stopped half way is finished first; Diagnostics only report it.
    if [[ -f $DARBAN_RESTORE_JOURNAL && $cmd != restore && $cmd != status ]]; then
        run_action restore_resume || true
        SERVER_PROBLEM=$(server_problem)
    fi
    # Diagnostics, updates and removal must work on a broken server; these two cannot.
    if [[ -n $SERVER_PROBLEM ]] && [[ $cmd == list || $cmd == repair-crl || $cmd == connected || $cmd == welcome || $cmd == enable-events ]]; then
        fail "$SERVER_PROBLEM"
        info 'Details: sudo darban status'
        exit 1
    fi
    case $cmd in
        list) run_action list_clients; exit "$ACTION_RC" ;;
        status) run_action health; exit "$ACTION_RC" ;;
        repair-crl) run_action repair_crl; exit "$ACTION_RC" ;;
        connected) run_action connected_clients; exit "$ACTION_RC" ;;
        welcome) welcome; exit 0 ;;
        update) run_action update_tool; exit "$ACTION_RC" ;;
        uninstall) run_action uninstall_tool; exit "$ACTION_RC" ;;
        remove-all) run_action remove_everything; exit "$ACTION_RC" ;;
        enable-events) run_action enable_events; exit "$ACTION_RC" ;;
        restore) run_action restore_command "${RESTORE_ARGS[@]}"; exit "$ACTION_RC" ;;
    esac
    if [[ -n $SERVER_PROBLEM ]]; then recovery_menu; fi
    main_menu
}
main "$@"
