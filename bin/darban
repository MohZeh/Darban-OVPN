#!/usr/bin/env bash
# Darban OVPN: the manager of an OpenVPN 2.7 and Easy-RSA 3 server.
set -Eeuo pipefail
umask 077
source /usr/local/lib/darban/common.sh
source /usr/local/lib/darban/ui.sh

DARBAN_VERSION=1.0.0-rc.7
DARBAN_REPO=MohZeh/Darban-OVPN
DARBAN_URL=https://github.com/$DARBAN_REPO
DARBAN_EMAIL=zehtabex@gmail.com
BACKUP_ROOT=/var/backups/darban
SBIN_DIR=/usr/local/sbin
UNIT_DIR=/etc/systemd/system
LINK_DIR=/run/darban-links
DEFAULT_CLIENT_DNS='1.1.1.1 8.8.8.8'
CONF_TEMP=''
OUT_DIR=/root/openvpn-clients
CONFIG_DIR=/etc/darban
DOMAIN_FILE=$CONFIG_DIR/domain
UPDATE_CACHE=$CONFIG_DIR/.latest-version
LINK_ENV=$CONFIG_DIR/links.env
LINK_CERT=$CONFIG_DIR/link-cert.pem
LINK_KEY=$CONFIG_DIR/link-key.pem
# The ports a first link tries, in order. Uncommon on purpose: panels such as 3x-ui, and tools such as Portainer,
# often take 443, 8443 and 9443, and a link would then block them while it lasts.
LINK_PORT_CHOICES='9347 9563 9741'
# Where a link certificate taken from another tool came from, so a renewal there reaches the links.
LINK_CERT_SOURCE=$CONFIG_DIR/link-cert.source
SYSTEM_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Where certbot, panels such as 3x-ui and x-ui, and acme.sh keep certificates.
CERT_SEARCH_DIRS='/etc/letsencrypt/live /root/cert /root/.acme.sh'
CONFIG_FILE=$CONFIG_DIR/config
TLS_KEY=$DARBAN_SERVER_DIR/tls-crypt.key
DEFAULT_DATA_CIPHERS=AES-256-GCM:AES-128-GCM
PORT_BACKUPS_KEPT=5
EXPIRY_WARN_DAYS=30
# Download hints; overridden by $CONFIG_FILE (see load_config). Empty host disables them.
DOWNLOAD_SSH_HOST=''
DOWNLOAD_SSH_PORT=22
DOWNLOAD_SSH_USER=root
# Days a new client certificate lasts; empty means the Easy-RSA default.
CLIENT_CERT_DAYS=''
# TCP port of temporary links; empty means the first free one is chosen when it is first needed.
LINK_PORT=''
# Hours a temporary link works at most; empty means 24.
LINK_HOURS=''
# The menu looks for a new release at most once a day; no turns that off.
UPDATE_CHECK=yes
CONFIG_ISSUES=()
# Normalized serial of the certificate OpenVPN serves; never listed, exported or revoked.
SERVER_SERIAL=''
# Action subshell exit codes besides 0 (done), 1 (refused/failed, reason printed) and 130 (Ctrl+C).
RC_NO_PAUSE=10
RC_QUIT=12
ACTION_RC=0
DARBAN_INT=0
SESSIONS_RESTARTED=0
ACTION_RUNNING=0
# Why this server cannot be managed right now; empty when it is healthy. Diagnostics and removal still work.
SERVER_PROBLEM=''
CA_LOCKED=0
# Set once a client has been given a way to get its profile, so the tool can wait for its first connection.
SHARED=0
# What the scp and sftp commands should fetch; another SSH user than root gets a private copy of the file.
DOWNLOAD_FILE=''
HEALTH_BAD=0
# Revoked clients are history: list_clients hides them unless LIST_ALL is set, and counts them in LIST_HIDDEN.
LIST_ALL=0
LIST_HIDDEN=0
PROFILE_PASSWORD=''
CHOSEN=1

# ---------- validation ----------
# A name of digits only could be confused with a number in a list.
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ && $1 != server && ! $1 =~ ^[0-9]+$ ]]; }
# Names of certificates that already exist: wider than valid_name (new clients stay strict), yet still
# safe as a file name and as one word of an Easy-RSA argument or a management-interface command.
valid_link_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_client_days() { [[ $1 =~ ^[0-9]{1,4}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 3650 )); }
# A link holds a private key and stays in chat histories, so it lasts three days at most.
valid_link_hours() { [[ $1 =~ ^[0-9]{1,2}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 72 )); }
link_hours() { printf '%s' "${LINK_HOURS:-24}"; }
hours_label() { if (( $1 == 1 )); then printf '1 hour'; else printf '%s hours' "$1"; fi; }
valid_existing_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._@+-]{0,127}$ && $1 != server ]]; }

# ---------- action runner ----------
# Interrupts are ignored while CA/CRL or server.conf changes are half-applied; children inherit this.
# Nested sections are counted, so an inner one cannot let Ctrl+C in before the outer one is done.
CRITICAL_DEPTH=0
critical_begin() { CRITICAL_DEPTH=$((CRITICAL_DEPTH + 1)); trap '' INT TERM HUP; }
critical_end() {
    if (( CRITICAL_DEPTH > 0 )); then CRITICAL_DEPTH=$((CRITICAL_DEPTH - 1)); fi
    if (( CRITICAL_DEPTH == 0 )); then trap 'exit 130' INT TERM HUP; fi
}
ca_lock() {
    # Held only while something changes, never while waiting for an answer, so a person thinking does not
    # hold up the daily CRL renewal. Whatever was checked before asking must be checked again after this.
    if (( ! CA_LOCKED )); then darban_lock || return 1; CA_LOCKED=1; fi
}
ca_unlock() {
    if (( CA_LOCKED )); then flock -u 9 2>/dev/null || true; exec 9>&-; CA_LOCKED=0; fi
}
run_action() {
    # errexit is ignored inside any function called from if/||/&&, so each action runs in its
    # own subshell with errexit really on, temp-file cleanup and Ctrl+C = cancel. The status lands in ACTION_RC.
    local rc=0
    set +e
    ACTION_RUNNING=1
    (
        set -e
        trap 'ui_restore; darban_tmp_cleanup' EXIT
        critical_end
        "$@"
    )
    rc=$?
    set -e
    ACTION_RUNNING=0
    DARBAN_INT=0
    ACTION_RC=$rc
    # A setting the action saved lives only in the file: read it again, so the menu shows it and the next
    # action uses it.
    load_config
    case $rc in
        0|1|"$RC_NO_PAUSE") ;;
        130) say; info 'Cancelled.' ;;
        "$RC_IDLE"|"$RC_QUIT") exit 0 ;;
        *) warn "Operation aborted unexpectedly (status $rc); see messages above." ;;
    esac
}
menu_action() {
    # menu_action <title> <function>: clean screen, run, then let the user read the result.
    local title=$1
    shift
    clear_screen
    section "$title"
    run_action "$@"
    if (( ACTION_RC != RC_NO_PAUSE )); then say; pause; fi
}

# ---------- configuration and server facts ----------
load_config() {
    local key value
    # The defaults first: the menu reads the file again after each action, and a setting returned to its
    # default has no line left in the file.
    DOWNLOAD_SSH_HOST='' DOWNLOAD_SSH_PORT=22 DOWNLOAD_SSH_USER=root CLIENT_CERT_DAYS='' LINK_PORT='' LINK_HOURS=''
    UPDATE_CHECK=yes
    CONFIG_ISSUES=()
    [[ -f $CONFIG_FILE ]] || { CONFIG_ISSUES+=("$CONFIG_FILE is missing; download commands are disabled."); return 0; }
    # Parsed as data, never sourced.
    while IFS='=' read -r key value || [[ -n $key ]]; do
        [[ $key =~ ^[[:space:]]*(#|$) ]] && continue
        case $key in
            DOWNLOAD_SSH_HOST) DOWNLOAD_SSH_HOST=$value ;;
            DOWNLOAD_SSH_PORT) DOWNLOAD_SSH_PORT=$value ;;
            DOWNLOAD_SSH_USER) DOWNLOAD_SSH_USER=$value ;;
            CLIENT_CERT_DAYS) CLIENT_CERT_DAYS=$value ;;
            LINK_PORT) LINK_PORT=$value ;;
            LINK_HOURS) LINK_HOURS=$value ;;
            UPDATE_CHECK) UPDATE_CHECK=$value ;;
            *) CONFIG_ISSUES+=("Unknown setting ignored in $CONFIG_FILE: $key") ;;
        esac
    done <"$CONFIG_FILE"
    if [[ -n $DOWNLOAD_SSH_HOST ]] && ! valid_ipv4 "$DOWNLOAD_SSH_HOST" && ! valid_domain "$DOWNLOAD_SSH_HOST"; then
        CONFIG_ISSUES+=("Invalid DOWNLOAD_SSH_HOST in $CONFIG_FILE."); DOWNLOAD_SSH_HOST=''
    fi
    if ! [[ $DOWNLOAD_SSH_PORT =~ ^[0-9]{1,5}$ ]] || (( 10#$DOWNLOAD_SSH_PORT < 1 || 10#$DOWNLOAD_SSH_PORT > 65535 )); then
        CONFIG_ISSUES+=("Invalid DOWNLOAD_SSH_PORT in $CONFIG_FILE."); DOWNLOAD_SSH_HOST=''
    fi
    if ! [[ $DOWNLOAD_SSH_USER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
        CONFIG_ISSUES+=("Invalid DOWNLOAD_SSH_USER in $CONFIG_FILE."); DOWNLOAD_SSH_HOST=''
    fi
    if [[ -n $CLIENT_CERT_DAYS ]] && ! valid_client_days "$CLIENT_CERT_DAYS"; then
        CONFIG_ISSUES+=("Invalid CLIENT_CERT_DAYS in $CONFIG_FILE; using the default."); CLIENT_CERT_DAYS=''
    fi
    if [[ $UPDATE_CHECK != yes && $UPDATE_CHECK != no ]]; then
        CONFIG_ISSUES+=("Invalid UPDATE_CHECK in $CONFIG_FILE; using yes."); UPDATE_CHECK=yes
    fi
    if [[ -n $LINK_PORT ]] && ! valid_link_port "$LINK_PORT"; then
        CONFIG_ISSUES+=("Invalid LINK_PORT in $CONFIG_FILE; choosing a free port."); LINK_PORT=''
    fi
    if [[ -n $LINK_HOURS ]] && ! valid_link_hours "$LINK_HOURS"; then
        CONFIG_ISSUES+=("Invalid LINK_HOURS in $CONFIG_FILE; links work for 24 hours."); LINK_HOURS=''
    fi
    if [[ -n $LINK_HOURS ]]; then LINK_HOURS=$((10#$LINK_HOURS)); fi
    if [[ -z $DOWNLOAD_SSH_HOST ]] && (( ${#CONFIG_ISSUES[@]} == 0 )); then
        CONFIG_ISSUES+=("DOWNLOAD_SSH_HOST is not set in $CONFIG_FILE; download commands are disabled.")
    fi
}
setup() {
    local cmd
    darban_require_root
    for cmd in systemctl ss find cp chmod chown timeout; do command -v "$cmd" >/dev/null || { darban_error "Missing dependency: $cmd"; return 1; }; done
    install -d -o root -g root -m 700 "$CONFIG_DIR" "$OUT_DIR"
    load_config
    SERVER_PROBLEM=$(server_problem)
    if [[ -z $SERVER_PROBLEM ]]; then SERVER_SERIAL=$(darban_server_serial); fi
}
server_problem() {
    # Prints why this server cannot be managed; nothing when it can.
    local out
    out=$(C_RED='' C_RESET='' darban_preflight 2>&1) || { printf '%s\n' "${out##*ERROR: }"; return 0; }
    if [[ ! -s $TLS_KEY ]]; then printf 'OpenVPN tls-crypt.key is missing.\n'; return 0; fi
    if ! darban_server_serial >/dev/null 2>&1; then
        printf "Cannot read the server certificate from server.conf (one 'cert' directive or an inline <cert> block).\n"
    fi
}
server_port() {
    awk '$1=="port" {n++; if ($2 !~ /^[0-9]+$/) bad=1; else port=$2} END {if(n!=1 || bad) exit 1; print port}' "$DARBAN_SERVER_CONF"
}
server_proto_ok() {
    [[ $(awk '$1=="proto" {n++; proto=$2} END {if(n!=1) print "invalid"; else print proto}' "$DARBAN_SERVER_CONF") == udp4 ]]
}
server_tls_ok() {
    # Profiles embed $TLS_KEY in a <tls-crypt> block, so the server must use exactly that mode and key.
    local path
    awk '$1=="tls-auth" || $1=="tls-crypt-v2" || $1 ~ /^<(tls-auth|tls-crypt|tls-crypt-v2)>/ {bad=1} END {exit bad}' "$DARBAN_SERVER_CONF" || return 1
    path=$(darban_conf_single tls-crypt) || return 1
    [[ $(darban_conf_path "$path") -ef $TLS_KEY ]]
}
server_data_ciphers() {
    # Mirror the server's negotiable list so profiles cannot drift from it.
    local value rc=0
    value=$(darban_conf_single data-ciphers) || rc=$?
    if (( rc == 1 )); then value=$DEFAULT_DATA_CIPHERS; elif (( rc != 0 )); then return 1; fi
    [[ $value =~ ^[A-Za-z0-9_:-]+$ ]] || return 1
    printf '%s\n' "$value"
}
profile_preconditions() {
    valid_domain "$(domain)" || { warn "The server address is not set yet. Set it first: Settings ${S_CRUMB} 1."; return 1; }
    server_port >/dev/null || { warn 'Cannot detect a unique OpenVPN server port in server.conf.'; return 1; }
    server_proto_ok || { warn 'Profile generation only supports the existing udp4 configuration.'; return 1; }
    server_tls_ok || {
        warn "server.conf must contain exactly one 'tls-crypt' directive using $TLS_KEY (no tls-auth, tls-crypt-v2 or inline keys)."; return 1;
    }
    server_data_ciphers >/dev/null || { warn 'server.conf data-ciphers is repeated or malformed.'; return 1; }
}
domain() { [[ -s $DOMAIN_FILE ]] && head -n 1 "$DOMAIN_FILE" || true; }

# ---------- dates ----------
cert_end_epoch() {
    local line
    line=$(openssl x509 -in "$1" -noout -enddate 2>/dev/null) || return 1
    date -u -d "${line#notAfter=}" +%s
}
days_until() { printf '%d\n' $(( ($1 - $(date -u +%s)) / 86400 )); }
describe_expiry() {
    # "2029-02-05 (820 days)" / "2026-10-01 (EXPIRED)"
    local epoch=$1 days
    days=$(days_until "$epoch")
    if (( epoch <= $(date -u +%s) )); then
        printf '%s (%sEXPIRED%s)\n' "$(date -u -d "@$epoch" +%Y-%m-%d)" "$C_RED" "$C_RESET"
    elif (( days <= EXPIRY_WARN_DAYS )); then
        printf '%s (%s%d days%s)\n' "$(date -u -d "@$epoch" +%Y-%m-%d)" "$C_YELLOW" "$days" "$C_RESET"
    else
        printf '%s (%d days)\n' "$(date -u -d "@$epoch" +%Y-%m-%d)" "$days"
    fi
}

# ---------- CA index ----------
client_index_rows() {
    # Never parse tab-separated CA records with shell read: empty fields cause shifts.
    awk -F '\t' 'NF>=6 && $6 ~ /\/CN=/ {
        cn=$6; sub(/^.*\/CN=/,"",cn); sub(/\/.*/,"",cn);
        printf "%s\t%s\t%s\t%s\n",cn,$1,$2,$4
    }' "$DARBAN_PKI/index.txt"
}
client_effective_rows() {
    # One row per name, sorted: the single valid record of a reissued name, otherwise its newest record.
    client_index_rows | awk -F '\t' '
        !($1 in seen) {seen[$1]=1; order[++n]=$1}
        $2=="V" {valid[$1]=1; row[$1]=$0}
        $2!="V" && !($1 in valid) {row[$1]=$0}
        END {for (i=1; i<=n; i++) print row[order[i]]}' | sort -t $'\t' -k1,1
}
client_index_count() {
    DARBAN_TARGET=$1 awk -F '\t' 'NF>=6 {cn=$6; sub(/^.*\/CN=/,"",cn); sub(/\/.*/,"",cn); if($6 ~ /\/CN=/ && cn==ENVIRON["DARBAN_TARGET"]) n++} END {print n+0}' "$DARBAN_PKI/index.txt"
}
client_index_lookup() {
    # "state<TAB>serial" for a name. Revoked and expired history of a reissued name does not make it
    # ambiguous: only more than one VALID record does, and then the output is just "AMBIGUOUS".
    DARBAN_TARGET=$1 awk -F '\t' '
        NF>=6 && $6 ~ /\/CN=/ {
            cn=$6; sub(/^.*\/CN=/,"",cn); sub(/\/.*/,"",cn)
            if (cn==ENVIRON["DARBAN_TARGET"]) {
                n++; state=$1; serial=$4
                if ($1=="V") {valid++; valid_serial=$4}
            }
        }
        END {
            if (valid>1) print "AMBIGUOUS"
            else if (valid==1) printf "V\t%s\n", valid_serial
            else if (n>0) printf "%s\t%s\n", state, serial
        }' "$DARBAN_PKI/index.txt"
}
client_index_status() { local row; row=$(client_index_lookup "$1"); printf '%s\n' "${row%%$'\t'*}"; }
client_index_serial() { local row; row=$(client_index_lookup "$1"); [[ $row != *$'\t'* ]] || printf '%s\n' "${row#*$'\t'}"; }
index_state_of_serial() {
    # State of one exact certificate, which a reissued name's status cannot tell.
    local want rows state expiry serial
    want=$(darban_norm_serial "$1") || return 1
    rows=$(darban_index_rows) || return 1
    while IFS=$'\t' read -r state expiry serial; do
        if [[ $(darban_norm_serial "$serial") == "$want" ]]; then printf '%s\n' "$state"; return 0; fi
    done <<<"$rows"
    return 1
}
is_server_serial() { [[ $(darban_norm_serial "$1" 2>/dev/null) == "$SERVER_SERIAL" ]]; }
safe_text() { printf '%s' "${1//[^[:print:]]/?}"; }
join_lines() { sort -u | awk '{s = s (s == "" ? "" : ", ") $0} END {print s}'; }
client_cert_safe() {
    # The server's own certificate (whatever its CN) and any server-capable certificate
    # must never be exported into a client profile or revoked from this menu.
    local crt=$DARBAN_PKI/issued/$1.crt serial
    serial=$(openssl x509 -in "$crt" -noout -serial 2>/dev/null) || return 1
    ! is_server_serial "${serial#serial=}" && darban_cert_is_client_only "$crt"
}
revoke_block_reason() {
    # Why a certificate the CA still counts as valid cannot be revoked here. Empty when it can be,
    # and for names with no valid certificate, where the question does not arise.
    local name=$1 state serial file_serial crt=$DARBAN_PKI/issued/$1.crt
    state=$(client_index_status "$name")
    case $state in
        V) ;;
        AMBIGUOUS) printf 'several valid certificates share this name; this tool will not guess which one to revoke\n'; return 0 ;;
        *) return 0 ;;
    esac
    if ! valid_existing_name "$name"; then printf 'this tool cannot manage this name safely\n'; return 0; fi
    serial=$(client_index_serial "$name")
    if [[ ! -s $crt ]]; then printf 'pki/issued/%s.crt is missing; restore it from pki/certs_by_serial/%s.pem\n' "$name" "$serial"; return 0; fi
    if ! file_serial=$(openssl x509 -in "$crt" -noout -serial 2>/dev/null); then printf 'pki/issued/%s.crt is unreadable\n' "$name"; return 0; fi
    if [[ $(darban_norm_serial "${file_serial#serial=}") != "$(darban_norm_serial "$serial")" ]]; then
        printf 'pki/issued/%s.crt is not the certificate the CA lists as valid (serial %s)\n' "$name" "$serial"; return 0
    fi
    if ! client_cert_safe "$name"; then printf 'this certificate can act as a server, so this menu will not touch it\n'; fi
}
export_block_reason() {
    # Why a valid certificate cannot be put into a profile; empty when it can be.
    local name=$1 reason key=$DARBAN_PKI/private/$1.key crt=$DARBAN_PKI/issued/$1.crt key_hash cert_hash
    reason=$(revoke_block_reason "$name")
    if [[ -n $reason ]]; then printf '%s\n' "$reason"; return 0; fi
    [[ $(client_index_status "$name") == V ]] || return 0
    if ! openssl x509 -in "$crt" -noout -checkend 0 >/dev/null 2>&1; then printf 'the certificate has expired\n'; return 0; fi
    if [[ ! -s $key ]]; then printf 'its private key pki/private/%s.key is missing\n' "$name"; return 0; fi
    key_hash=$(openssl pkey -in "$key" -passin pass: -pubout -outform DER 2>/dev/null | openssl dgst -sha256) || key_hash=''
    cert_hash=$(openssl x509 -in "$crt" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | openssl dgst -sha256) || cert_hash=''
    if [[ -z $key_hash || $key_hash != "$cert_hash" ]]; then printf 'its private key does not match the certificate\n'; fi
}
client_valid() { [[ $(client_index_status "$1") == V && -z $(export_block_reason "$1") ]]; }
name_taken() {
    [[ $(client_index_count "$1") != 0 || -e $DARBAN_PKI/issued/$1.crt || -e $DARBAN_PKI/private/$1.key || -e $OUT_DIR/$1.ovpn ]]
}
similar_names() {
    # Clients with a valid certificate whose name differs only in letter case ("Ali" vs "ali"), comma-separated.
    client_index_rows | awk -F '\t' -v t="$1" '$2=="V" && tolower($1)==tolower(t) && $1!=t {print $1}' | join_lines
}
revocation_pending_names() {
    # Revoked, unexpired clients the active CRL does not list: revoked in the CA, not yet blocked by OpenVPN.
    local cn status expiry serial norm now e list rows
    local -A listed=()
    now=$(date -u +%s)
    if darban_crl_signature_ok "$DARBAN_CRL"; then
        list=$(darban_crl_serials "$DARBAN_CRL") || return 1
        while IFS= read -r serial; do
            [[ -n $serial ]] || continue
            norm=$(darban_norm_serial "$serial") || return 1
            listed["$norm"]=1
        done <<<"$list"
    fi
    rows=$(client_index_rows) || return 1
    while IFS=$'\t' read -r cn status expiry serial; do
        [[ $status == R ]] || continue
        norm=$(darban_norm_serial "$serial") || return 1
        [[ -v listed[$norm] ]] && continue
        # An unreadable date counts as not expired.
        e=$(darban_index_expiry_epoch "$expiry" 2>/dev/null) || e=$((now + 1))
        if (( e > now )); then printf '%s\n' "$cn"; fi
    done <<<"$rows"
}
revoked_with_profile() {
    # A normal revocation deletes the server copy, so a copy left behind marks an unfinished one.
    local cn status expiry serial rows
    rows=$(client_effective_rows) || return 1
    while IFS=$'\t' read -r cn status expiry serial; do
        if [[ $status == R ]] && profile_path "$cn" >/dev/null; then printf '%s\n' "$cn"; fi
    done <<<"$rows"
}
client_stats() {
    # Prints: valid revoked expired expiring-soon
    local cn status expiry serial e now valid=0 revoked=0 expired=0 soon=0
    now=$(date -u +%s)
    while IFS=$'\t' read -r cn status expiry serial; do
        if is_server_serial "$serial"; then continue; fi
        e=$(darban_index_expiry_epoch "$expiry" 2>/dev/null || echo 0)
        if [[ $status == R ]]; then
            revoked=$((revoked + 1))
        elif [[ $status == V ]] && (( e > now )); then
            valid=$((valid + 1))
            if (( e - now <= EXPIRY_WARN_DAYS * 86400 )); then soon=$((soon + 1)); fi
        else
            expired=$((expired + 1))
        fi
    done < <(client_index_rows)
    printf '%d %d %d %d\n' "$valid" "$revoked" "$expired" "$soon"
}
profile_path() {
    local name=$1
    [[ -s $OUT_DIR/$name.ovpn ]] || return 1
    printf '%s\n' "$OUT_DIR/$name.ovpn"
}
# Predicates deciding which clients each picker offers.
can_reexport() { client_valid "$1"; }
can_delete_export() { profile_path "$1" >/dev/null; }
show_blocked() {
    # show_blocked "<name>: <reason>"...: certificates this action cannot use, and why.
    local line
    (( $# > 0 )) || return 0
    say
    say 'Valid, but not available for this action:'
    for line in "$@"; do bullet "$line"; done
}
can_revoke() { [[ $(client_index_status "$1") == V && -z $(revoke_block_reason "$1") ]]; }
pick_client() {
    # pick_client <question> <predicate> [reason-function]: numbered list of matching clients;
    # sets PICKED to a name. Returns 1 when cancelled or when nothing matches.
    # Clients the reason function explains are listed apart, so a valid certificate never just vanishes.
    local question=$1 predicate=$2 explain=${3:-} cn status expiry serial e i extra reason
    local -a names=() notes=() blocked=()
    while IFS=$'\t' read -r cn status expiry serial; do
        if is_server_serial "$serial"; then continue; fi
        if ! "$predicate" "$cn"; then
            reason=''
            if [[ -n $explain ]]; then reason=$("$explain" "$cn") || reason=''; fi
            if [[ -n $reason ]]; then blocked+=("$(safe_text "$cn"): $reason"); fi
            continue
        fi
        e=$(darban_index_expiry_epoch "$expiry" 2>/dev/null || echo 0)
        extra=''
        if (( e > 0 )); then extra="expires $(describe_expiry "$e")"; fi
        if profile_path "$cn" >/dev/null; then extra+=" $S_SEP profile on server"; fi
        names+=("$cn"); notes+=("$extra")
    done < <(client_effective_rows)
    if (( ${#names[@]} == 0 )); then
        info 'No clients are available for this action.'
        show_blocked "${blocked[@]}"
        return 1
    fi
    say "$question"
    for i in "${!names[@]}"; do
        printf '  %s%3d%s  %-24s %s%s%s\n' "$C_KEY" $((i + 1)) "$C_RESET" "${names[i]}" "$C_HINT" "${notes[i]}" "$C_RESET"
    done
    show_blocked "${blocked[@]}"
    say
    while :; do
        if ! ask 'Number or name (Enter = cancel): ' || [[ -z $REPLY ]]; then cancelled; return 1; fi
        # The exact name first: an older client may be called just "2".
        for cn in "${names[@]}"; do
            if [[ $cn == "$REPLY" ]]; then PICKED=$cn; return 0; fi
        done
        if [[ $REPLY =~ ^[0-9]+$ ]] && (( 10#$REPLY >= 1 && 10#$REPLY <= ${#names[@]} )); then
            PICKED=${names[10#$REPLY - 1]}; return 0
        fi
        warn "\"$REPLY\" is not in the list above. Enter its number or exact name."
    done
}

# ---------- profiles and downloads ----------
assemble_profile() {
    # Every step is checked explicitly: callers use this from an if, where errexit does not apply.
    local name=$1 host=$2 port=$3 ciphers=$4
    cat <<EOF || return 1
client
dev tun
proto udp4
remote $host $port
resolv-retry infinite
nobind
remote-cert-tls server
tls-version-min 1.2
data-ciphers $ciphers
auth-nocache
persist-tun
verb 3
# The name OpenVPN Connect shows for this profile, instead of the server address. Other clients ignore it.
setenv FRIENDLY_NAME "$name"

<ca>
EOF
    openssl x509 -in "$DARBAN_PKI/ca.crt" -outform PEM || return 1
    printf '</ca>\n<cert>\n' || return 1
    openssl x509 -in "$DARBAN_PKI/issued/$name.crt" -outform PEM || return 1
    printf '</cert>\n<key>\n' || return 1
    if [[ -n $PROFILE_PASSWORD ]]; then
        # PBKDF2 with 600000 rounds: the password is short, so guessing it from a stolen file must be slow.
        openssl pkcs8 -topk8 -in "$DARBAN_PKI/private/$name.key" -v2 aes-256-cbc -v2prf hmacWithSHA256 -iter 600000 \
            -passout stdin <<<"$PROFILE_PASSWORD" || return 1
    else
        cat -- "$DARBAN_PKI/private/$name.key" || return 1
    fi
    printf '</key>\n<tls-crypt>\n' || return 1
    cat -- "$TLS_KEY" || return 1
    printf '</tls-crypt>\n'
}
profile_complete() {
    awk '/^<(ca|cert|key|tls-crypt)>$/ {o[$0]++} /^<\/(ca|cert|key|tls-crypt)>$/ {c[$0]++}
        END {exit !(o["<ca>"]==1 && o["<cert>"]==1 && o["<key>"]==1 && o["<tls-crypt>"]==1 &&
                    c["</ca>"]==1 && c["</cert>"]==1 && c["</key>"]==1 && c["</tls-crypt>"]==1)}' "$1"
}
write_profile() {
    local name=$1 replace=${2:-no} host port ciphers outfile tmp
    client_valid "$name" || { warn 'The client certificate/key is missing, expired, server-capable or does not match.'; return 1; }
    profile_preconditions || return 1
    host=$(domain)
    port=$(server_port) || return 1
    ciphers=$(server_data_ciphers) || return 1
    outfile="$OUT_DIR/$name.ovpn"
    if [[ -e $outfile && $replace != yes ]]; then warn "Profile exists and will not be replaced: $outfile"; return 1; fi
    tmp=$(mktemp "$OUT_DIR/.profile.XXXXXXXX") || return 1
    darban_tmp_register "$tmp"
    if ! assemble_profile "$name" "$host" "$port" "$ciphers" >"$tmp" || ! profile_complete "$tmp"; then
        rm -f -- "$tmp"; warn 'Could not assemble profile.'; return 1
    fi
    chmod 600 "$tmp" || return 1
    if ! mv -f -- "$tmp" "$outfile"; then rm -f -- "$tmp"; return 1; fi
}
security_note() {
    printf '%s%s This file contains a private key; do not share or publish it.%s\n' "$C_YELLOW" "$S_WARN" "$C_RESET" || true
}
download_panel() {
    # download_panel <file> <title> [windows|unix|sftp]. Commands are printed uncolored, unindented and one
    # per line, so copying them from the terminal never picks up escape codes or frame characters.
    local file=$1 title=$2 only=${3:-all} name filename current_remote expected cert_exp fetch=${DOWNLOAD_FILE:-$1}
    filename=${file##*/}
    name=${filename%.ovpn}
    ok "$title"
    hr
    current_remote=$(grep -m1 '^remote ' "$file" || true)
    kv File "$fetch"
    if [[ -n $current_remote ]]; then
        kv Server "$(awk '{print $2 ":" $3 "/UDP"}' <<<"$current_remote")"
    else
        kv Server unknown
    fi
    if cert_exp=$(cert_end_epoch "$DARBAN_PKI/issued/$name.crt"); then kv 'Valid to' "$(describe_expiry "$cert_exp")"; fi
    expected="remote $(domain) $(server_port 2>/dev/null || printf '?')"
    if [[ $current_remote != "$expected" ]]; then
        warn "This file points to ${current_remote#remote } but the server is now ${expected#remote }. Share it again (menu 5) first."
    fi
    say
    if [[ -z $DOWNLOAD_SSH_HOST ]]; then
        warn "Download commands unavailable: set DOWNLOAD_SSH_HOST (and DOWNLOAD_SSH_PORT/USER) in $CONFIG_FILE."
    else
        if [[ $only == all || $only == windows ]]; then
            say '  Windows (PowerShell):'
            printf '%s%s%s\n' "$C_CMD" "$(download_command windows "$file")" "$C_RESET" || true
            say
        fi
        if [[ $only == all || $only == unix ]]; then
            say '  macOS / Linux:'
            printf '%s%s%s\n' "$C_CMD" "$(download_command unix "$file")" "$C_RESET" || true
            say
        fi
        if [[ $only == all || $only == sftp ]]; then
            say '  WinSCP / FileZilla (SFTP):'
            printf '%s%s%s\n' "$C_LINK" "$(download_command sftp "$file")" "$C_RESET" || true
            say
        fi
    fi
    security_note
    hr
}
download_command() {
    # download_command <windows|unix|sftp> <file>: the plain text of one way to fetch the file, for the panel
    # and for the clipboard alike.
    local fetch=${DOWNLOAD_FILE:-$2} target=$DOWNLOAD_SSH_USER@$DOWNLOAD_SSH_HOST
    case $1 in
        windows) printf 'scp -P %s %s:%s "$env:USERPROFILE\\Downloads\\%s"' "$DOWNLOAD_SSH_PORT" "$target" "$fetch" "${2##*/}" ;;
        unix) printf 'scp -P %s %s:%s ~/Downloads/' "$DOWNLOAD_SSH_PORT" "$target" "$fetch" ;;
        sftp) printf 'sftp://%s:%s%s' "$target" "$DOWNLOAD_SSH_PORT" "$fetch" ;;
    esac
}

# ---------- actions ----------
set_domain() {
    local old value tmp resolved
    old=$(domain)
    kv Current "${old:-not set}"
    say
    info 'Only new or shared-again .ovpn files use this address.'
    info 'Use a DNS-only record (no Cloudflare orange-cloud proxy) for this UDP service.'
    say
    prompt_valid 'New hostname or IP, e.g. vpn.example.com (Enter = cancel): ' valid_endpoint \
        'Enter a hostname such as vpn.example.com, or an IPv4 address such as 203.0.113.10.' || return 0
    value=${REPLY,,}
    [[ $value != "$old" ]] || { info 'Same as the current address; nothing changed.'; return 0; }
    if command -v getent >/dev/null; then
        resolved=$(getent ahostsv4 "$value" 2>/dev/null | awk 'NR==1 {print $1}' || true)
        if [[ -z $resolved ]]; then
            warn 'This name does not resolve to an IPv4 address yet. Check the DNS record before clients use it.'
        elif valid_ipv4 "$DOWNLOAD_SSH_HOST" && [[ $resolved != "$DOWNLOAD_SSH_HOST" ]]; then
            warn "It resolves to $resolved, but this VPS is $DOWNLOAD_SSH_HOST. Make sure that is intentional."
        else
            ok "Resolves to $resolved."
        fi
    fi
    confirm_choice "Save $value as the server address?" 'No, keep the current one' "Save $value" normal || { cancelled; return 0; }
    ca_lock || return 1
    tmp=$(mktemp "$CONFIG_DIR/.domain.XXXXXXXX") || return 1
    darban_tmp_register "$tmp"
    if ! printf '%s\n' "$value" >"$tmp" || ! chmod 600 "$tmp" || ! mv -f -- "$tmp" "$DOMAIN_FILE"; then
        fail 'Could not save the address.'; return 1
    fi
    audit "server address changed: ${old:-unset} -> $value"
    ok 'Saved.'
    info 'Profiles downloaded earlier still use the old address; share them again (menu 5).'
}
list_clients() {
    local cn status expiry serial e now label rank days name_w=6 out line cell color profile shown reason pending
    local valid=0 revoked=0 expired=0 soon=0 hidden=0
    local -a rows=()
    now=$(date -u +%s)
    while IFS=$'\t' read -r cn status expiry serial; do
        if is_server_serial "$serial"; then continue; fi
        if [[ $status == R ]] && (( ! LIST_ALL )); then hidden=$((hidden + 1)); continue; fi
        e=$(darban_index_expiry_epoch "$expiry" 2>/dev/null || echo 0)
        case $status in
            V) if (( e > now )); then label=VALID rank=1; else label=EXPIRED rank=2; fi ;;
            R) label=REVOKED rank=3 ;;
            E) label=EXPIRED rank=2 ;;
            *) label=$status rank=4 ;;
        esac
        if (( e == 0 )); then label=BAD-DATE; fi
        rows+=("$rank"$'\t'"$cn"$'\t'"$label"$'\t'"$e")
        if (( ${#cn} > name_w )); then name_w=${#cn}; fi
    done < <(client_index_rows)
    LIST_HIDDEN=$hidden
    revoked=$hidden
    if (( ${#rows[@]} == 0 && hidden == 0 )); then info 'No clients yet. Create one with menu 1.'; return 0; fi
    (( name_w <= 32 )) || name_w=32
    if (( ${#rows[@]} > 0 )); then
        printf -v out '  %s%-*s  %-8s  %-10s  %5s  %s%s\n' "$C_BOLD" "$name_w" CLIENT STATUS EXPIRES DAYS PROFILE "$C_RESET"
    else
        out=$'  No active clients.\n'
    fi
    while IFS=$'\t' read -r rank cn label e; do
        [[ -n $cn ]] || continue
        shown=$(safe_text "$cn")
        if (( ${#shown} > name_w )); then shown="${shown:0:name_w-1}$S_ELL"; fi
        case $label in VALID) color=$C_GREEN ;; REVOKED) color=$C_DIM ;; *) color=$C_RED ;; esac
        printf -v cell '%-8s' "$label"
        printf -v line '  %-*s  %s%s%s  ' "$name_w" "$shown" "$color" "$cell" "$C_RESET"
        if (( e > 0 )); then line+=$(date -u -d "@$e" +%Y-%m-%d); else line+='?         '; fi
        if [[ $label == VALID ]]; then
            days=$(( (e - now) / 86400 ))
            if (( days <= EXPIRY_WARN_DAYS )); then
                soon=$((soon + 1)); printf -v cell '%5d' "$days"; line+="  $C_YELLOW$cell$C_RESET"
            else
                printf -v cell '%5d' "$days"; line+="  $cell"
            fi
            valid=$((valid + 1))
        else
            line+="      -"
            if [[ $label == REVOKED ]]; then revoked=$((revoked + 1)); else expired=$((expired + 1)); fi
        fi
        # The server copy belongs to a reissued name's valid certificate, not to its revoked history.
        profile='-'
        if { [[ $label == VALID ]] || [[ $(client_index_status "$cn") != V ]]; } && profile_path "$cn" >/dev/null; then profile="$S_OK on server"; fi
        out+="$line  $profile"$'\n'
    done < <(printf '%s\n' "${rows[@]}" | sort -t $'\t' -k1,1n -k2,2)
    printf -v line '\n  %d valid %s %d revoked %s %d expired' "$valid" "$S_SEP" "$revoked" "$S_SEP" "$expired"
    out+=$line
    if (( soon > 0 )); then out+=" $S_SEP $C_YELLOW$soon expiring within $EXPIRY_WARN_DAYS days$C_RESET"; fi
    if (( LIST_ALL )); then
        out+=$'\n'"  ${C_DIM}Revoked clients stay in the CA index because the CRL depends on them.${C_RESET}"$'\n'
    elif (( hidden > 0 )); then
        out+=$'\n'"  ${C_DIM}Revoked clients are hidden. To see them: sudo darban list --all${C_RESET}"$'\n'
    else
        out+=$'\n'
    fi
    while IFS=$'\t' read -r cn status expiry serial; do
        if is_server_serial "$serial"; then continue; fi
        reason=$(revoke_block_reason "$cn") || reason=''
        if [[ -n $reason ]]; then out+=$'\n'"  $C_YELLOW$S_WARN$C_RESET $(safe_text "$cn") cannot be revoked here: $reason"; fi
    done < <(client_effective_rows)
    pending=$(revocation_pending_names | join_lines) || pending=''
    if [[ -n $pending ]]; then out+=$'\n'"  $C_RED$S_WARN$C_RESET Revoked but NOT blocked yet: $(safe_text "$pending") $S_ARROW Maintenance $S_CRUMB 2"; fi
    out+=$'\n'
    emit "$out"
}
list_menu() {
    list_clients
    (( UI_TTY && LIST_HIDDEN > 0 )) || return 0
    say
    confirm_choice 'Show revoked clients too?' 'No, back to the menu' "Show $LIST_HIDDEN revoked" normal || no_pause
    clear_screen
    section 'Clients, including revoked'
    LIST_ALL=1
    list_clients
}
name_reuse_block_reason() {
    # Why a name already in the CA history cannot get a new certificate; empty when it safely can.
    # OpenVPN rejects the old certificate by serial, so the old one must be proven blocked first.
    local name=$1 state serial file
    state=$(client_index_status "$name")
    case $state in
        V|AMBIGUOUS) printf 'it still has a valid certificate.\n'; return 0 ;;
    esac
    serial=$(client_index_serial "$name")
    if [[ -n $serial ]] && is_server_serial "$serial"; then printf 'it belongs to the server certificate.\n'; return 0; fi
    if ! darban_verify_crl "$DARBAN_CRL" >/dev/null 2>&1; then printf 'the published CRL has a problem; fix it first: Maintenance %s 2.\n' "$S_CRUMB"; return 0; fi
    if [[ -n $(revoked_with_profile | grep -Fx -- "$name") ]]; then printf 'its revocation is unfinished; finish it first: Maintenance %s 2.\n' "$S_CRUMB"; return 0; fi
    # Each of these would make Easy-RSA refuse, or would pair the new certificate with an old file.
    for file in "issued/$name.crt" "private/$name.key" "reqs/$name.req"; do
        if [[ -e $DARBAN_PKI/$file ]]; then printf 'pki/%s is still there.\n' "$file"; return 0; fi
    done
    if [[ -e $OUT_DIR/$name.ovpn ]]; then printf '%s is still there.\n' "$OUT_DIR/$name.ovpn"; fi
}
client_settings_file() {
    # The per-client server settings OpenVPN would apply to this name (fixed IP, routes), if any.
    local dir
    dir=$(darban_conf_single client-config-dir 2>/dev/null) || return 1
    dir=$(darban_conf_path "$dir")
    [[ -f $dir/$1 ]] || return 1
    printf '%s\n' "$dir/$1"
}
confirm_name_reuse() {
    # The old certificate is already proven blocked, so reusing the name is routine. The one thing
    # that silently carries over is the per-client server configuration, and only that is asked about.
    local name=$1 file
    if ! file=$(client_settings_file "$name"); then
        info "\"$name\" was revoked before. Its old .ovpn files stay blocked; only the new file will connect."
        return 0
    fi
    say
    warn "Server settings for this name exist in $file and will apply to the new certificate."
    confirm_choice "Issue a new certificate for $name with those settings?" 'No, choose another name' 'Yes, issue it' caution "$name"
}
create_client() {
    # create_client [suggested name]: with a suggestion, Enter takes it; without one, Enter cancels.
    local suggested=${1:-} name similar reason reused=0 rc=0
    local hint='Use 1-64 letters, digits, _ or -, starting with a letter or digit. It cannot be "server" or only digits.'
    profile_preconditions || return 1
    info 'A name for this person or device, such as ali-phone. Letters, digits, _ and - only.'
    if [[ -n $suggested ]]; then info "Press Enter to use $suggested, or type a name and press Enter."; fi
    say
    while :; do
        if [[ -n $suggested ]]; then
            ask "Client name [$suggested]: " || { cancelled; return 0; }
            REPLY=${REPLY:-$suggested}
            if ! valid_name "$REPLY"; then warn "$hint"; continue; fi
        else
            prompt_valid 'New client name (Enter = cancel): ' valid_name "$hint" || return 0
        fi
        name=$REPLY
        reused=0
        if name_taken "$name"; then
            reason=$(name_reuse_block_reason "$name")
            if [[ -n $reason ]]; then
                warn "\"$name\" cannot be used: $reason"
                continue
            fi
            confirm_name_reuse "$name" || { say; continue; }
            reused=1
        fi
        break
    done
    similar=$(similar_names "$name")
    if [[ -n $similar ]]; then
        warn "Existing name(s) differing only in letter case: $similar"
        confirm_choice "Create \"$name\" anyway?" 'No, do not create it' "Create $name" caution || { cancelled; return 0; }
    fi
    ca_lock || return 1
    # Another administrator may have taken the name while this one was being typed.
    if (( ! reused )) && name_taken "$name"; then warn "\"$name\" was created by another session just now. Choose another name."; return 1; fi
    info "Issuing a certificate and unencrypted private key for $name${S_ELL}"
    critical_begin
    if [[ -n $CLIENT_CERT_DAYS ]]; then
        EASYRSA_CERT_EXPIRE=$CLIENT_CERT_DAYS run_easyrsa build-client-full "$name" nopass || rc=$?
    else
        run_easyrsa build-client-full "$name" nopass || rc=$?
    fi
    critical_end
    if (( rc != 0 )); then fail 'Certificate issuance failed. Inspect the PKI state before trying again.'; return 1; fi
    if (( reused )); then audit "client created again with a used name: $name"; else audit "client created: $name"; fi
    info "Building the .ovpn profile${S_ELL}"
    if ! write_profile "$name" no; then
        fail 'The certificate was issued but the .ovpn export failed. Use Share (menu 5) instead of creating it again.'; return 1
    fi
    ca_unlock
    say
    if (( ! UI_TTY )); then
        # A script has nobody to answer the sharing questions.
        download_panel "$OUT_DIR/$name.ovpn" "Client \"$name\" created and verified"
        no_pause
    fi
    ok "Client \"$name\" created and verified"
    say
    share_client "$name"
    if ! { (( SHARED )) && wait_for_connection "$name"; }; then pause; fi
    no_pause
}
# ---------- sharing ----------
share_profile() {
    profile_preconditions || return 1
    pick_client 'Share which client?' can_reexport export_block_reason || return 0
    ca_lock || return 1
    write_profile "$PICKED" yes || return 1
    ca_unlock
    audit "profile rebuilt: $PICKED"
    clear_screen
    share_client "$PICKED"
    if (( SHARED )) && wait_for_connection "$PICKED"; then no_pause; fi
}
share_client() {
    # share_client <name>: asks how the profile travels and shows only that method. The QR code of a link is
    # offered with the link itself, and the download commands come with keeping the file on the server.
    local name=$1 method
    choose_one "How will $name get this profile?" \
        'Temporary link: send it to the user' \
        'Keep it on the server: download it with scp or sftp' || {
        info "Kept on the server: $OUT_DIR/$name.ovpn. Share it from menu 5, or delete it from menu 6."
        return 0
    }
    method=$CHOSEN
    SHARED=1
    PROFILE_PASSWORD=''
    say
    if (( method == 2 )); then
        # The admin fetches this file over SSH, which already proves the server: a password would add nothing.
        share_by_download "$name"
        return 0
    fi
    # The link's certificate is settled first, because a link without a trusted one gets a word about the password.
    prepare_link || return 1
    if link_cert_is_trusted; then choose_profile_password; else choose_profile_password untrusted; fi
    if [[ -n $PROFILE_PASSWORD ]]; then
        ca_lock || return 1
        write_profile "$name" yes || return 1
        ca_unlock
    fi
    say
    share_by_link "$name" || return 1
}
share_text() {
    # share_text <link> <password> <note>: what goes to the person, each label and value on its own line.
    local text=''
    if [[ -n $1 ]]; then text+=$'Link:\n'$1$'\n'; fi
    if [[ -n $2 ]]; then text+=$'Password:\n'$2$'\n'; fi
    if [[ -n $3 ]]; then text+=$'Note:\n'$3$'\n'; fi
    printf '%s' "${text%$'\n'}"
}
show_share_block() {
    # show_share_block <link> <password> <note>: the same lines as share_text, unindented and with no frame, so
    # one mouse selection from the first label down copies exactly what the copy key copies.
    say "${C_BOLD}Send this to the person:${C_RESET}"
    say
    if [[ -n $1 ]]; then say "${C_BOLD}Link:${C_RESET}"; say "$C_LINK$1$C_RESET"; fi
    if [[ -n $2 ]]; then say "${C_BOLD}Password:${C_RESET}"; say "$C_SECRET$2$C_RESET"; fi
    if [[ -n $3 ]]; then say "${C_BOLD}Note:${C_RESET}"; say "$3"; fi
    say
}
offer_copy() {
    # offer_copy <what to select instead> <extra option or ''> <option> <text> [<option> <text>]...: Enter copies
    # the first text. Returns 3 when the extra option, placed after the copy options, was chosen. Only a terminal
    # has a clipboard to reach; a script gets no question, so its answers stay in step.
    local select=$1 extra=$2 i
    shift 2
    (( UI_TTY )) || return 0
    local -a labels=() texts=()
    while (( $# >= 2 )); do labels+=("$1"); texts+=("$2"); shift 2; done
    if [[ -n $extra ]]; then labels+=("$extra"); fi
    choose_one 'Copy it to your clipboard?' "${labels[@]}" 'Do not copy' || return 0
    i=$(( CHOSEN - 1 ))
    if [[ -n $extra ]] && (( i == ${#texts[@]} )); then return 3; fi
    (( i < ${#texts[@]} )) || return 0
    copy_to_clipboard "${texts[i]}" || { warn 'Could not copy.'; return 0; }
    ok 'Copied to your clipboard, if your terminal allows it.'
    info "If pasting does not give this text, your terminal does not allow it (PuTTY, for example). Select $select with the mouse instead."
}
make_password() {
    # Nine characters in one piece: nothing that might or might not belong to it, easy to type on a phone, and
    # no characters that look alike. Bytes from 248 up are skipped, so all 31 characters are equally likely.
    local alphabet=abcdefghjkmnpqrstuvwxyz23456789 raw='' out='' i=0 count=0 byte
    while (( count < 9 )); do
        if (( i * 2 >= ${#raw} )); then raw=$(openssl rand -hex 32) || return 1; i=0; fi
        byte=$(( 16#${raw:i*2:2} )); i=$(( i + 1 ))
        (( byte < 248 )) || continue
        out+=${alphabet:$(( byte % ${#alphabet} )):1}
        count=$(( count + 1 ))
    done
    printf '%s\n' "$out"
}
choose_profile_password() {
    # choose_profile_password [untrusted]: Enter means no password. A link without a trusted certificate gets
    # a word about it, and the choice stays with the person.
    local suggested
    PROFILE_PASSWORD=''
    if [[ ${1:-} == untrusted ]]; then info 'This link has no trusted certificate. A password on the key protects the profile if someone else gets the file.'; fi
    confirm_choice 'Lock the private key with a password?' 'No password' 'Yes, make a password' normal '' 1 || return 0
    suggested=$(make_password) || { fail 'Could not create a password.'; return 1; }
    PROFILE_PASSWORD=$suggested
    (( UI_TTY )) || return 0
    # The suggestion stands on its own line in the color it has in the final block, so it reads as the
    # password and not as part of a sentence.
    say
    say "${C_BOLD}Suggested password:${C_RESET}"
    say "$C_SECRET$suggested$C_RESET"
    say
    info 'Press Enter to use it. Or type your own: a word or a short phrase of at least 9 characters, in English letters, digits, spaces or symbols.'
    while :; do
        ask 'Password (Enter = the suggested one): ' || { PROFILE_PASSWORD=$suggested; return 0; }
        if [[ -z $REPLY ]]; then
            PROFILE_PASSWORD=$suggested
            ok 'The suggested password is used.'
            return 0
        fi
        if (( ${#REPLY} < 9 )); then warn 'Use at least 9 characters.'; continue; fi
        # Another keyboard can encode other letters differently, and the key would then not open on the device.
        if printf '%s' "$REPLY" | LC_ALL=C grep -q '[^ -~]'; then
            warn 'Use only English letters, digits, spaces and symbols, so the password types the same on every device.'
            continue
        fi
        PROFILE_PASSWORD=$REPLY
        ok 'Your password is used.'
        return 0
    done
}
prepare_download_copy() {
    # Profiles live under /root, which only root can read. Another SSH user gets a private copy in their home.
    local file=$1 home
    DOWNLOAD_FILE=''
    [[ $DOWNLOAD_SSH_USER != root ]] || return 0
    home=$(getent passwd "$DOWNLOAD_SSH_USER" 2>/dev/null | cut -d: -f6) || home=''
    if [[ -z $home || ! -d $home ]]; then
        warn "$DOWNLOAD_SSH_USER has no home directory here, so it cannot read $file."
        return 0
    fi
    if install -o "$DOWNLOAD_SSH_USER" -m 600 "$file" "$home/${file##*/}"; then
        DOWNLOAD_FILE=$home/${file##*/}
    else
        warn "Could not make a copy for $DOWNLOAD_SSH_USER, which cannot read $file."
    fi
}
home_copy_of() {
    # home_copy_of <name>: the private copy made for a non-root download user, when it is still this client's.
    # Only a file that holds this client's certificate counts, so nothing else in that home is touched.
    local name=$1 home copy want got
    [[ $DOWNLOAD_SSH_USER != root ]] || return 1
    home=$(getent passwd "$DOWNLOAD_SSH_USER" 2>/dev/null | cut -d: -f6) || return 1
    copy=$home/$name.ovpn
    [[ -n $home && -f $copy && ! -L $copy ]] || return 1
    want=$(openssl x509 -in "$DARBAN_PKI/issued/$name.crt" -noout -fingerprint -sha256 2>/dev/null) || return 1
    got=$(sed -n '/^<cert>$/,/^<\/cert>$/p' "$copy" | sed '1d;$d' | openssl x509 -noout -fingerprint -sha256 2>/dev/null) || return 1
    [[ -n $want && $want == "$got" ]] || return 1
    printf '%s\n' "$copy"
}
delete_home_copy() {
    # delete_home_copy <path>: path from home_copy_of, found before anything changed.
    [[ -n $1 ]] || return 0
    if rm -f -- "$1"; then ok "Copy for $DOWNLOAD_SSH_USER deleted: $1"; audit "profile deleted from server: $1"; else warn "Could not delete the copy for $DOWNLOAD_SSH_USER: $1"; fi
}
share_by_download() {
    # The file stays on the server, with every way to fetch it, now or later.
    local name=$1
    prepare_download_copy "$OUT_DIR/$name.ovpn"
    download_panel "$OUT_DIR/$name.ovpn" "Profile for \"$name\" rebuilt"
    info "Kept on the server: $OUT_DIR/$name.ovpn. After downloading it, delete it from menu 6."
    [[ -n $DOWNLOAD_SSH_HOST ]] || return 0
    offer_copy 'the command' '' \
        'Copy the Windows command' "$(download_command windows "$OUT_DIR/$name.ovpn")" \
        'Copy the macOS or Linux command' "$(download_command unix "$OUT_DIR/$name.ovpn")" \
        'Copy the SFTP address' "$(download_command sftp "$OUT_DIR/$name.ovpn")"
}
tcp_port_open() { timeout 1 bash -c 'exec 3<>"/dev/tcp/127.0.0.1/$0"' "$1" 2>/dev/null; }
tcp_port_taken() {
    # True when another program listens on TCP $1, on any address: a panel bound only to the public IP counts
    # too. The link service itself does not.
    local listeners pid
    listeners=$(ss -H -ltnp "sport = :$1" 2>/dev/null) || listeners=''
    if [[ -z $listeners ]]; then tcp_port_open "$1"; return; fi
    for pid in $(grep -o 'pid=[0-9]*' <<<"$listeners" | cut -d= -f2 | sort -u); do
        tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q '/linkd\.py ' || return 0
    done
    # Held, but by no process this tool can see.
    grep -q 'pid=' <<<"$listeners" || return 0
    return 1
}
tcp_port_program() {
    # The name of the program that listens on TCP $1, or "another program".
    local name
    name=$(ss -H -ltnp "sport = :$1" 2>/dev/null | grep -o '(("[^"]*"' | head -n 1 | tr -d '("')
    printf '%s\n' "${name:-another program}"
}
choose_link_port() {
    # The first free one is remembered, so links keep working on a port the firewall already allows. It is
    # checked again for each link: a panel installed later may have taken it.
    local candidate
    if [[ -n $LINK_PORT ]]; then
        if tcp_port_taken "$LINK_PORT"; then
            fail "TCP $LINK_PORT, the port for links, is now used by $(safe_text "$(tcp_port_program "$LINK_PORT")"). Choose another one: Settings $S_CRUMB Link port."
            return 1
        fi
        return 0
    fi
    if candidate=$(next_link_port); then
        LINK_PORT=$candidate
        save_config || warn 'Could not save the link port.'
        return 0
    fi
    fail "Ports ${LINK_PORT_CHOICES// /, } are all used by other programs. Choose one: Settings $S_CRUMB Link port."
    return 1
}
next_link_port() {
    # The port the first link will take: the first of the choices that no other program uses.
    local candidate
    for candidate in $LINK_PORT_CHOICES; do
        if ! tcp_port_taken "$candidate"; then printf '%s\n' "$candidate"; return 0; fi
    done
    return 1
}
link_port_summary() {
    # For Settings: the saved port, or the one the first link will take.
    local next
    if [[ -n $LINK_PORT ]]; then printf '%s\n' "$LINK_PORT"; return; fi
    if next=$(next_link_port); then printf '%s\n' "$next"; else printf 'all of %s are in use\n' "${LINK_PORT_CHOICES// /, }"; fi
}
host_is_ip() { [[ $1 =~ ^[0-9.]+$ ]]; }
link_cert_usable() {
    # link_cert_usable <host> [seconds]: valid that much longer, by default an hour longer than a link lasts,
    # and for the address clients will open.
    local host=$1 seconds=${2:-$(( ($(link_hours) + 1) * 3600 ))} check
    [[ -s $LINK_CERT && -s $LINK_KEY ]] || return 1
    openssl x509 -in "$LINK_CERT" -noout -checkend "$seconds" >/dev/null 2>&1 || return 1
    # A key and a certificate that do not belong together, whatever left them so, are replaced like any
    # unusable pair, instead of stopping every link until the certificate is changed by hand.
    cert_key_matches "$LINK_CERT" "$LINK_KEY" || return 1
    if host_is_ip "$host"; then check=-checkip; else check=-checkhost; fi
    openssl x509 -in "$LINK_CERT" -noout "$check" "$host" 2>/dev/null | grep -q 'does match'
}
link_cert_is_trusted() { [[ -L $LINK_CERT || -s $LINK_CERT_SOURCE ]]; }
CERT_NAME=darban-ovpn-links
# Let's Encrypt issues IP address certificates from Certbot 5.3 on; a hostname works with any version.
CERTBOT_IP_MIN=5.3
have_snap() { command -v snap >/dev/null; }
version_at_least() { [[ $(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1) == "$2" ]]; }
find_certbot() {
    # find_certbot <minimum version>: prints a certbot that is new enough, if there is one.
    local candidate version
    for candidate in /snap/bin/certbot "$(command -v certbot 2>/dev/null || true)"; do
        [[ -n $candidate && -x $candidate ]] || continue
        version=$("$candidate" --version 2>/dev/null | awk '{print $2; exit}') || continue
        if [[ $version =~ ^[0-9]+(\.[0-9]+)*$ ]] && version_at_least "$version" "$1"; then printf '%s\n' "$candidate"; return 0; fi
    done
    return 1
}
record_added() {
    # What the server setup's record lists is what Remove everything takes away again.
    local marker=$CONFIG_DIR/.server-setup-started
    if [[ -e $marker ]]; then printf '%s\n' "$1" >>"$marker" || true; fi
}
install_certbot() {
    # install_certbot <minimum version>: Ubuntu's own package when it is new enough; otherwise the Certbot
    # project's snap. There is no third way: get_trusted_cert does not offer one without snap.
    local need=$1
    apt-get -o DPkg::Lock::Timeout=120 -qq update >/dev/null || true
    if [[ $need == 0 ]]; then
        info "Installing certbot from Ubuntu${S_ELL}"
        apt-get -o DPkg::Lock::Timeout=120 -y -q --no-install-recommends install certbot >/dev/null || return 1
        record_added 'package certbot'
    else
        info "Installing certbot from the Certbot project (snap)${S_ELL}"
        snap install --classic certbot >/dev/null || return 1
        record_added 'snap certbot'
    fi
}
get_trusted_cert() {
    # get_trusted_cert <host> [asked]: Let's Encrypt for a hostname or a public IP address. It needs TCP 80
    # from the internet for a moment. "asked" means the person already chose it, so there is no question.
    local host=$1 asked=${2:-} need=0 certbot
    local -a target
    if host_is_ip "$host"; then
        is_private_ip "$host" && return 1
        need=$CERTBOT_IP_MIN
        target=(--preferred-profile shortlived --ip-address "$host")
    else
        target=(-d "$host")
    fi
    if [[ $need != 0 ]] && ! find_certbot "$need" >/dev/null && ! have_snap; then
        info "A trusted certificate for an IP address needs certbot $CERTBOT_IP_MIN or newer. Ubuntu does not ship it yet, and this server has no snap to get it from the Certbot project."
        return 1
    fi
    if [[ $asked != asked ]]; then
        say
        info "A trusted certificate for $host means the person opening the link sees no browser warning."
        if [[ $need != 0 ]]; then
            info "For an IP address it lasts six days, and a new one is requested when a link needs it. It needs certbot $CERTBOT_IP_MIN or newer, from the Certbot project."
        fi
        info 'It needs TCP port 80 open in your provider firewall and free on this server for a moment. Choosing yes accepts the Let'"'"'s Encrypt subscriber agreement.'
        choose_one 'Get a free Let'"'"'s Encrypt certificate?' 'Yes, get a certificate' 'No, use a self-signed certificate (browser warning)' || return 1
        (( CHOSEN == 1 )) || return 1
    fi
    if tcp_port_taken 80; then warn "TCP port 80 is used by $(safe_text "$(tcp_port_program 80)"), so certbot cannot answer on it."; return 1; fi
    if ! certbot=$(find_certbot "$need"); then
        install_certbot "$need" || { warn 'Could not install certbot.'; return 1; }
        certbot=$(find_certbot "$need") || { warn "No certbot $need or newer is available."; return 1; }
    fi
    info "Requesting a certificate for $host${S_ELL}"
    "$certbot" certonly --standalone --non-interactive --agree-tos --register-unsafely-without-email --cert-name "$CERT_NAME" \
        "${target[@]}" --deploy-hook 'systemctl try-restart darban-links.service' >/dev/null 2>&1 || {
        warn 'certbot could not get a certificate. Check that the address points here and TCP 80 is open in the provider firewall.'
        return 1
    }
    # Recorded only once it exists, so a removal never deletes a certificate this tool did not get.
    record_added "certbot_cert $CERT_NAME"
    # The new links are made beside the current pair and then renamed over it, so a failure keeps the old one.
    local new_cert new_key
    new_cert=$CONFIG_DIR/.link-cert.new new_key=$CONFIG_DIR/.link-key.new
    rm -f -- "$new_cert" "$new_key"
    if ln -s "/etc/letsencrypt/live/$CERT_NAME/fullchain.pem" "$new_cert" \
        && ln -s "/etc/letsencrypt/live/$CERT_NAME/privkey.pem" "$new_key" \
        && mv -fT -- "$new_key" "$LINK_KEY" && mv -fT -- "$new_cert" "$LINK_CERT"; then
        rm -f -- "$LINK_CERT_SOURCE"
        ok 'Trusted certificate installed.'
        return 0
    fi
    rm -f -- "$new_cert" "$new_key"
    warn 'The certificate was issued, but could not be put in place; the current one stays.'
    return 1
}
make_self_signed_cert() {
    # Made beside the current pair and then renamed over it, so a failure keeps the old one.
    local host=$1 san new_cert=$CONFIG_DIR/.link-cert.new new_key=$CONFIG_DIR/.link-key.new
    if host_is_ip "$host"; then san=IP:$host; else san=DNS:$host; fi
    rm -f -- "$new_cert" "$new_key"
    if openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout "$new_key" -out "$new_cert" -days 90 \
        -subj "/CN=$host" -addext "subjectAltName=$san" >/dev/null 2>&1 \
        && chmod 600 "$new_key" "$new_cert" \
        && mv -fT -- "$new_key" "$LINK_KEY" && mv -fT -- "$new_cert" "$LINK_CERT"; then
        rm -f -- "$LINK_CERT_SOURCE"
        return 0
    fi
    rm -f -- "$new_cert" "$new_key"
    fail 'Could not create a certificate for the link.'
    return 1
}

# ---------- a certificate that is already on this server ----------
cert_covers() {
    # cert_covers <cert> <host>: the certificate names this hostname or IP address.
    local check
    if host_is_ip "$2"; then check=-checkip; else check=-checkhost; fi
    openssl x509 -in "$1" -noout "$check" "$2" 2>/dev/null | grep -q 'does match'
}
cert_key_matches() {
    local cert_pub key_pub
    cert_pub=$(openssl x509 -in "$1" -noout -pubkey 2>/dev/null) || return 1
    key_pub=$(openssl pkey -in "$2" -pubout 2>/dev/null) || return 1
    [[ -n $cert_pub && $cert_pub == "$key_pub" ]]
}
cert_publicly_trusted() {
    # The first certificate in the file, checked against the system's trusted authorities with the rest of
    # the file as its chain: what a browser would accept from this file.
    local dir rc=0
    dir=$(mktemp -d) || return 1
    awk -v d="$dir" '/-----BEGIN CERTIFICATE-----/ {n++} n {print > (d (n == 1 ? "/leaf.pem" : "/chain.pem"))}' "$1" 2>/dev/null || rc=1
    if (( rc == 0 )) && [[ -s $dir/leaf.pem ]]; then
        if [[ -s $dir/chain.pem ]]; then
            openssl verify -CAfile "$SYSTEM_CA_FILE" -untrusted "$dir/chain.pem" "$dir/leaf.pem" >/dev/null 2>&1 || rc=1
        else
            openssl verify -CAfile "$SYSTEM_CA_FILE" "$dir/leaf.pem" >/dev/null 2>&1 || rc=1
        fi
    else
        rc=1
    fi
    rm -rf -- "$dir"
    return "$rc"
}
cert_is_cloudflare_origin() { openssl x509 -in "$1" -noout -issuer 2>/dev/null | grep -qi 'cloudflare origin'; }
cert_end_date() { date -u -d "$(openssl x509 -in "$1" -noout -enddate 2>/dev/null | cut -d= -f2)" +%Y-%m-%d 2>/dev/null; }
existing_cert_pairs() {
    # Certificate and key pairs where other tools keep them: certbot, panels such as 3x-ui, and acme.sh.
    local root dir name
    for root in $CERT_SEARCH_DIRS; do
        for dir in "$root"/*/; do
            [[ -d $dir ]] || continue
            dir=${dir%/}
            name=${dir##*/}
            [[ $name == "$CERT_NAME" ]] && continue
            if [[ -s $dir/fullchain.pem && -s $dir/privkey.pem ]]; then
                printf '%s\t%s\n' "$dir/fullchain.pem" "$dir/privkey.pem"
            elif [[ -s $dir/fullchain.cer && -s $dir/${name%_ecc}.key ]]; then
                printf '%s\t%s\n' "$dir/fullchain.cer" "$dir/${name%_ecc}.key"
            fi
        done
    done
}
cert_problem() {
    # cert_problem <cert> <key> <host>: why this pair cannot serve links, or nothing when it can.
    if [[ ! -s $1 ]]; then printf 'There is no certificate file at %s.\n' "$1"; return; fi
    if [[ ! -s $2 ]]; then printf 'There is no key file at %s.\n' "$2"; return; fi
    if ! openssl x509 -in "$1" -noout >/dev/null 2>&1; then printf '%s is not a PEM certificate.\n' "$1"; return; fi
    if ! cert_covers "$1" "$3"; then printf 'The certificate in %s is not for %s.\n' "$1" "$3"; return; fi
    if ! cert_key_matches "$1" "$2"; then printf 'The key in %s does not belong to that certificate.\n' "$2"; return; fi
    if ! openssl x509 -in "$1" -noout -checkend 90000 >/dev/null 2>&1; then printf 'The certificate in %s ends within a day.\n' "$1"; return; fi
    if cert_is_cloudflare_origin "$1"; then
        printf '%s\n' "The certificate in $1 is a Cloudflare Origin certificate. Browsers trust it only through Cloudflare's proxy, and the VPN address cannot go through that proxy, because OpenVPN uses UDP. The browser would still warn."
        return
    fi
    if ! cert_publicly_trusted "$1"; then printf 'Browsers would not trust the certificate in %s: it is self-signed, or its file lacks the intermediate certificates.\n' "$1"; fi
}
find_existing_cert() {
    # Prints "cert<TAB>key<TAB>end date" of the trusted pair for this host that lasts longest.
    local host=$1 cert key end best='' best_end=''
    while IFS=$'\t' read -r cert key; do
        [[ -n $cert ]] || continue
        [[ -z $(cert_problem "$cert" "$key" "$host") ]] || continue
        end=$(cert_end_date "$cert") || continue
        if [[ -z $best || $end > $best_end ]]; then best="$cert"$'\t'"$key"$'\t'"$end"; best_end=$end; fi
    done < <(existing_cert_pairs)
    [[ -n $best ]] && printf '%s\n' "$best"
}
explain_untrusted_certs() {
    # A certificate for this host that cannot be used is named, so nobody wonders why it was passed over.
    local host=$1 cert key problem
    while IFS=$'\t' read -r cert key; do
        [[ -n $cert ]] && cert_covers "$cert" "$host" || continue
        problem=$(cert_problem "$cert" "$key" "$host")
        if [[ -n $problem ]]; then info "$problem"; fi
    done < <(existing_cert_pairs)
}
copy_cert_pair() {
    # copy_cert_pair <cert> <key> <host>: both files are copied beside the current pair and checked there as a
    # pair, then put in place. A failure before that leaves the current pair as it was. A renewal elsewhere
    # between the two copies gives a pair that does not match, and is refused the same way. The two renames
    # cannot be one step; if only the first is done, link_cert_usable sees the pair does not match.
    local cert=$1 key=$2 host=$3 new_cert new_key
    new_cert=$(mktemp "$CONFIG_DIR/.link-cert.XXXXXX") || return 1
    new_key=$(mktemp "$CONFIG_DIR/.link-key.XXXXXX") || { rm -f -- "$new_cert"; return 1; }
    if cp -- "$cert" "$new_cert" && cp -- "$key" "$new_key" && chmod 600 "$new_cert" "$new_key" \
        && [[ -z $(cert_problem "$new_cert" "$new_key" "$host") ]] \
        && mv -f -- "$new_key" "$LINK_KEY" && mv -f -- "$new_cert" "$LINK_CERT"; then
        return 0
    fi
    rm -f -- "$new_cert" "$new_key"
    return 1
}
use_existing_cert() {
    # A copy, not a link: the link service cannot read /root. Each new link copies it again after a renewal.
    local cert=$1 key=$2 host
    host=$(domain)
    copy_cert_pair "$cert" "$key" "$host" || { fail "Could not take the certificate from $(safe_text "$cert"); the current one stays."; return 1; }
    printf '%s\n%s\n' "$cert" "$key" >"$LINK_CERT_SOURCE" || return 1
    chmod 600 "$LINK_CERT_SOURCE"
    audit "link certificate taken from $cert"
    ok "Links use the trusted certificate from $(safe_text "$cert"). When it is renewed there, the next link takes the new one."
}
refresh_copied_cert() {
    # A certificate taken from elsewhere is copied again once its owner has renewed it.
    local host=$1 cert='' key=''
    [[ -s $LINK_CERT_SOURCE ]] || return 0
    { IFS= read -r cert; IFS= read -r key; } <"$LINK_CERT_SOURCE" || true
    [[ -n $cert && -n $key ]] || return 0
    if cmp -s -- "$cert" "$LINK_CERT" && cmp -s -- "$key" "$LINK_KEY"; then return 0; fi
    if [[ -z $(cert_problem "$cert" "$key" "$host") ]] && copy_cert_pair "$cert" "$key" "$host"; then
        info "The link certificate was renewed in $(safe_text "$cert"); links use the new one."
    fi
}
offer_trusted_cert() {
    # A trusted certificate already on this server comes first, then Let's Encrypt. Returns 1 when neither.
    local host=$1 found cert key end
    if found=$(find_existing_cert "$host"); then
        IFS=$'\t' read -r cert key end <<<"$found"
        say
        info "This server already has a trusted certificate for $host, in $(safe_text "$cert"), valid until $end."
        choose_one 'Which certificate should links use?' 'The one already on this server' "A new one from Let's Encrypt" 'A self-signed one (browser warning)' || return 1
        case $CHOSEN in
            1) use_existing_cert "$cert" "$key"; return ;;
            2) get_trusted_cert "$host" asked; return ;;
            *) return 1 ;;
        esac
    fi
    explain_untrusted_certs "$host"
    get_trusted_cert "$host"
}
ensure_link_cert() {
    local host=$1
    local ends
    refresh_copied_cert "$host"
    if link_cert_usable "$host"; then
        # A self-signed certificate is no reason to stop offering a trusted one: the question returns with each
        # link, and No keeps the current certificate.
        link_cert_is_trusted || offer_trusted_cert "$host" || true
        return 0
    fi
    if offer_trusted_cert "$host"; then return 0; fi
    # A trusted certificate that still works is kept, so open links do not change to a self-signed one.
    if link_cert_is_trusted && link_cert_usable "$host" 0; then
        ends=$(openssl x509 -in "$LINK_CERT" -noout -enddate 2>/dev/null | cut -d= -f2)
        warn "The current trusted certificate stays. It ends ${ends:-soon}; a link that lasts longer stops opening then."
        return 0
    fi
    make_self_signed_cert "$host"
}
link_cert_summary() {
    local end
    [[ -s $LINK_CERT ]] || { printf 'none yet\n'; return; }
    end=$(cert_end_date "$LINK_CERT") || end='?'
    if [[ -s $LINK_CERT_SOURCE ]]; then
        printf 'trusted, from %s, until %s\n' "$(head -n 1 "$LINK_CERT_SOURCE")" "$end"
    elif [[ -L $LINK_CERT ]]; then
        printf "trusted, Let's Encrypt, until %s\n" "$end"
    else
        printf 'self-signed, until %s\n' "$end"
    fi
}
change_link_cert() {
    local host cert key guess problem found end
    host=$(domain)
    [[ -n $host ]] && valid_endpoint "$host" || { warn "Set the server address first: Settings $S_CRUMB 1."; return 1; }
    kv Current "$(safe_text "$(link_cert_summary)")"
    say
    choose_one 'Which certificate should links use?' 'Find a trusted one on this server' 'A certificate file on this server' "A new one from Let's Encrypt" 'Keep the current one' || { cancelled; return 0; }
    case $CHOSEN in
        1)
            if found=$(find_existing_cert "$host"); then
                IFS=$'\t' read -r cert key end <<<"$found"
                info "Found: $(safe_text "$cert"), valid until $end."
                use_existing_cert "$cert" "$key"
            else
                info "No trusted certificate for $host was found where certbot, panels such as 3x-ui, and acme.sh keep them."
                explain_untrusted_certs "$host"
            fi ;;
        2)
            info 'Usually two files: the certificate with its chain (fullchain), and the private key.'
            prompt_valid 'Certificate file (Enter = cancel): ' valid_abs_path 'Enter a full path that starts with /.' || return 0
            cert=$REPLY
            guess=''
            if [[ -s ${cert%/*}/privkey.pem ]]; then guess=${cert%/*}/privkey.pem; elif [[ -s ${cert%.*}.key ]]; then guess=${cert%.*}.key; fi
            if [[ -n $guess ]]; then
                ask "Key file [$guess]: " || { cancelled; return 0; }
                key=${REPLY:-$guess}
            else
                prompt_valid 'Key file (Enter = cancel): ' valid_abs_path 'Enter a full path that starts with /.' || return 0
                key=$REPLY
            fi
            problem=$(cert_problem "$cert" "$key" "$host")
            if [[ -n $problem ]]; then warn "$problem Nothing changed."; return 1; fi
            use_existing_cert "$cert" "$key" ;;
        3) get_trusted_cert "$host" asked || warn 'The current certificate stays.' ;;
        *) info 'The current certificate stays.' ;;
    esac
}
valid_abs_path() { [[ $1 == /* && $1 != *$'\n'* ]]; }
start_link_service() {
    local attempt
    printf 'LINK_HOST=%s\nLINK_PORT=%s\n' "$1" "$LINK_PORT" >"$LINK_ENV" || return 1
    chmod 600 "$LINK_ENV" || return 1
    systemctl restart darban-links.service || return 1
    for attempt in 1 2 3 4 5 6; do
        if tcp_port_open "$LINK_PORT"; then return 0; fi
        sleep 0.5
    done
    return 1
}
links_locked() {
    # links_locked <command>...: changes the link files while holding the lock the link service takes too, so a
    # download in progress never writes back a link that is being removed.
    [[ -d $LINK_DIR ]] || { "$@"; return; }
    ( flock -w 10 8 || { warn 'The link service did not let go of its files; try again.'; exit 1; }; "$@" ) 8>"$LINK_DIR/.lock"
}
remove_links_for() {
    # A revoked client must not stay reachable through a link that is still open.
    [[ -d $LINK_DIR ]] || return 0
    links_locked drop_links_of "$1"
}
drop_links_of() {
    local meta
    for meta in "$LINK_DIR"/*.meta; do
        [[ -e $meta ]] || continue
        if grep -qx "name=$1" "$meta"; then rm -f -- "$meta" "${meta%.meta}.ovpn"; fi
    done
}
prepare_link() {
    # Everything a link needs before the questions about it: python, the address, a port and a certificate.
    local host
    command -v python3 >/dev/null || { fail 'python3 is needed for temporary links. Install it: apt install python3'; return 1; }
    host=$(domain)
    [[ -n $host ]] && valid_endpoint "$host" || { warn "Set the server address first: Settings $S_CRUMB 1."; return 1; }
    choose_link_port || return 1
    ensure_link_cert "$host"
}
share_by_link() {
    local name=$1 host hours minutes label token key now expires url temp note='' qr='Show a QR code' rc
    host=$(domain)
    if link_sees_connections; then
        info "The link stops working after $(hours_label "$(link_hours)"), or about 10 seconds after a connection with this profile is seen, whichever comes first. Until then it can be opened again. To change the time: Settings $S_CRUMB Link lifetime."
    else
        warn "This server has no local management interface, so the link cannot see a connection: it works for $(hours_label "$(link_hours)")."
    fi
    # A link must not outlive its certificate. That can only happen with a trusted one that could not be renewed:
    # the link then gets the whole hours the certificate has left.
    hours=$(link_hours)
    while (( hours > 0 )) && ! link_cert_usable "$host" $(( hours * 3600 )); do hours=$(( hours - 1 )); done
    if (( hours == 0 )); then
        fail 'The link certificate ends in less than an hour, so no link was made. Open TCP 80 in your provider firewall, and share again for a new certificate.'
        return 1
    fi
    label=$(hours_label "$hours")
    minutes=$(( hours * 60 ))
    if (( hours < $(link_hours) )); then warn "The link certificate ends sooner than $(hours_label "$(link_hours)"), so this link works for at most $label."; fi
    ca_lock || return 1
    # The answers above took time: this client may have been revoked since.
    client_valid "$name" || { warn "\"$name\" no longer has a valid certificate, so no link was made."; return 1; }
    install -d -m 700 "$LINK_DIR" || return 1
    token=$(openssl rand -hex 32) || return 1
    key=$(printf '%s' "$token" | sha256sum | awk '{print $1}')
    now=$(date -u +%s)
    expires=$(( now + minutes * 60 ))
    install -m 600 "$OUT_DIR/$name.ovpn" "$LINK_DIR/$key.ovpn" || return 1
    # The .meta file appears last: until then, the link does not exist for the server.
    temp=$LINK_DIR/$key.tmp
    printf 'name=%s\nexpires=%s\ncreated=%s\ndownloads=0\n' "$name" "$expires" "$now" >"$temp" || return 1
    mv -f -- "$temp" "$LINK_DIR/$key.meta" || return 1
    if ! start_link_service "$host"; then
        rm -f -- "$LINK_DIR/$key.meta" "$LINK_DIR/$key.ovpn"
        fail "The link service did not start on TCP $LINK_PORT. Check: $(cmd journalctl -u darban-links.service -n 30 --no-pager)"
        return 1
    fi
    # The link holds its own copy, so nothing stays behind in the download folder.
    rm -f -- "$OUT_DIR/$name.ovpn"
    ca_unlock
    audit "temporary link created: $name, valid for $label"
    url=https://$host
    if [[ $LINK_PORT != 443 ]]; then url+=:$LINK_PORT; fi
    url+=/l/$token
    ok "Temporary link for \"$name\""
    hr
    if link_sees_connections; then kv Valid "$label, or until a connection with this profile is seen"; else kv Valid "$label"; fi
    kv Cancel 'menu 6'
    say
    warn "TCP $LINK_PORT must be open in your provider firewall."
    if ! link_cert_is_trusted; then
        warn 'This server has no trusted certificate, so the browser shows a warning for this link. The note below tells the person what to do.'
        info "Certificate fingerprint: $(openssl x509 -in "$LINK_CERT" -noout -fingerprint -sha256 | sed 's/^.*=//')"
        # English only: a terminal shows right-to-left text backwards. The guides have the note in Persian.
        note='Your browser will warn that this connection is not private, because this server has no trusted certificate. Only for this link, which came to you straight from me: choose Advanced, then Continue. Never do this for other sites.'
    fi
    if [[ -n $PROFILE_PASSWORD ]]; then
        info 'The password is shown only now. To send it another way than the link, for example by SMS or a call, copy without it.'
        info 'In OpenVPN Connect, the person can turn on "Save private key password" when importing, so it is asked only once.'
    fi
    info "Until the link ends, anyone who has it can get this profile. If a connection you did not expect shows up, revoke the client and issue a new one."
    hr
    show_share_block "$url" "$PROFILE_PASSWORD" "$note"
    hr
    # The QR code holds the same link, for a phone in front of you; once drawn, the question comes back without it.
    while :; do
        rc=0
        if [[ -n $PROFILE_PASSWORD ]]; then
            offer_copy 'the lines from "Link:" down' "$qr" \
                "$(copy_label "$note" password)" "$(share_text "$url" "$PROFILE_PASSWORD" "$note")" \
                'Copy without the password' \
                "$(share_text "$url" '' "${note:+$note }The file is locked. Its password comes to you separately.")" || rc=$?
        else
            offer_copy 'the lines from "Link:" down' "$qr" "$(copy_label "$note")" "$(share_text "$url" '' "$note")" || rc=$?
        fi
        (( rc == 3 )) || break
        say
        show_qr "$url"
        qr=''
    done
}
copy_label() {
    # copy_label <note> [password]: names what the first copy option holds.
    if [[ -n ${2:-} && -n $1 ]]; then printf 'Copy link, password and note'
    elif [[ -n ${2:-} ]]; then printf 'Copy link and password'
    elif [[ -n $1 ]]; then printf 'Copy link and note'
    else printf 'Copy the link'; fi
}
show_qr() {
    local marker=$CONFIG_DIR/.server-setup-started
    if ! command -v qrencode >/dev/null; then
        if confirm_choice 'The small qrencode package is needed to draw the QR code. Install it?' 'No, just show the link' 'Install qrencode' normal; then
            apt-get -o DPkg::Lock::Timeout=120 -qq update >/dev/null || true
            apt-get -o DPkg::Lock::Timeout=120 -y -q --no-install-recommends install qrencode >/dev/null || warn 'Could not install qrencode.'
            if command -v qrencode >/dev/null && [[ -e $marker ]]; then printf 'package qrencode\n' >>"$marker" || true; fi
        fi
    fi
    if command -v qrencode >/dev/null; then
        qrencode -t ANSIUTF8 "$1" || warn 'Could not draw the QR code; use the link above.'
        say
    fi
}
pending_shares() {
    # What was shared but may not be picked up yet: links still open, and profile files left on the server.
    # Each row has one action: a link is cancelled, a file is deleted.
    local meta name state expires now minutes left i cn path serial
    local -a kinds=() refs=() names=() whats=() states=()
    now=$(date -u +%s)
    if [[ -d $LINK_DIR ]]; then
        for meta in "$LINK_DIR"/*.meta; do
            [[ -e $meta ]] || continue
            expires=$(awk -F= '$1=="expires" {print $2}' "$meta")
            if [[ ! $expires =~ ^[0-9]+$ ]] || (( expires <= now )); then
                links_locked rm -f -- "$meta" "${meta%.meta}.ovpn" || true
                continue
            fi
            name=$(awk -F= '$1=="name" {print $2}' "$meta")
            state=$(awk -F= '$1=="downloads" {print $2}' "$meta")
            if [[ $state =~ ^[1-9][0-9]*$ ]]; then state=downloaded; else state='not downloaded'; fi
            minutes=$(( (expires - now + 59) / 60 ))
            left="$minutes min"
            if (( minutes >= 60 )); then left="$(( minutes / 60 )) h"; fi
            if (( minutes >= 60 && minutes % 60 )); then left+=" $(( minutes % 60 )) min"; fi
            kinds+=(link) refs+=("$meta") names+=("$name") whats+=("link, $left left") states+=("$state")
        done
    fi
    while IFS=$'\t' read -r cn _ _ serial; do
        if is_server_serial "$serial"; then continue; fi
        path=$(profile_path "$cn") || continue
        kinds+=(file) refs+=("$path") names+=("$cn") whats+=('file on the server') states+=("$path")
    done < <(client_effective_rows)
    if (( ${#kinds[@]} == 0 )); then info 'Nothing is waiting to be picked up. Share a profile from menu 5.'; return 0; fi
    printf '  %s%3s  %-20s %-24s %s%s\n' "$C_BOLD" '' CLIENT 'WAITING AS' STATUS "$C_RESET"
    for i in "${!kinds[@]}"; do
        printf '  %s%3d%s  %-20s %-24s %s\n' "$C_KEY" $((i + 1)) "$C_RESET" "$(safe_text "${names[i]}")" "${whats[i]}" "${states[i]}"
    done
    say
    while :; do
        if ! ask 'Number to cancel the link or delete the file (Enter = back): ' || [[ -z $REPLY ]]; then return 0; fi
        if [[ $REPLY =~ ^[0-9]+$ ]] && (( 10#$REPLY >= 1 && 10#$REPLY <= ${#kinds[@]} )); then
            i=$(( 10#$REPLY - 1 ))
            if [[ ${kinds[i]} == link ]]; then
                links_locked rm -f -- "${refs[i]}" "${refs[i]%.meta}.ovpn" || return 1
                audit "temporary link cancelled: ${names[i]}"
                ok "Link for \"$(safe_text "${names[i]}")\" cancelled."
            else
                delete_server_copy "${names[i]}"
            fi
            return
        fi
        warn "\"$REPLY\" is not in the list above."
    done
}
delete_server_copy() {
    # delete_server_copy <name>: the .ovpn file kept on the server, and the copy made for the SSH user.
    local name=$1 path home_copy
    path=$OUT_DIR/$name.ovpn
    home_copy=$(home_copy_of "$name") || home_copy=''
    info 'The certificate stays valid, and the profile can be shared again later.'
    info 'Copies already downloaded to devices are not affected.'
    if [[ -n $home_copy ]]; then info "The copy made for $DOWNLOAD_SSH_USER is deleted too: $home_copy"; fi
    confirm_choice "Delete $path?" 'No, keep it' 'Delete the file' danger || { cancelled; return 0; }
    ca_lock || return 1
    rm -f -- "$path"
    audit "profile deleted from server: $path"
    ok "Deleted: $path"
    delete_home_copy "$home_copy"
}
run_easyrsa() {
    # Easy-RSA's own notices (e.g. "now run gen-crl") contradict the automated flow and bury the
    # result, so its output is kept out of sight and shown only when it fails.
    local log rc=0
    log=$(mktemp "${TMPDIR:-/tmp}/darban-easyrsa.XXXXXXXX") || return 1
    darban_tmp_register "$log"
    env EASYRSA_PKI="$DARBAN_PKI" EASYRSA_BATCH=1 "$DARBAN_EASYRSA" "$@" </dev/null >"$log" 2>&1 || rc=$?
    if (( rc != 0 )); then
        fail "Easy-RSA '$1' failed (status $rc). Its output:"
        sed 's/^/    /' "$log" >&2 || true
    fi
    rm -f -- "$log"
    return "$rc"
}
mgmt_send() {
    # mgmt_send <command> [seconds]: prints the reply of a password-less management interface on a unix
    # socket or localhost TCP. Returns 2 = no usable interface, 1 = failed. OpenVPN drops the reply to a
    # command that arrives together with "quit", so quit has to wait until the reply has gone out.
    local command=$1 wait=${2:-0.3} spec addr port extra
    spec=$(awk '$1=="management" {n++; s=$2 "\t" $3 "\t" $4} END {if(n==1) print s}' "$DARBAN_SERVER_CONF")
    [[ -n $spec ]] || return 2
    IFS=$'\t' read -r addr port extra <<<"$spec"
    [[ -z $extra ]] || return 2
    if [[ $port == unix ]]; then
        addr=$(darban_conf_path "$addr")
        command -v socat >/dev/null && [[ -S $addr ]] || return 2
        { printf '%s\n' "$command"; sleep "$wait"; printf 'quit\n'; } | timeout 10 socat -t 2 - "UNIX-CONNECT:$addr" 2>/dev/null || return 1
    else
        [[ $addr == 127.0.0.1 || $addr == localhost || $addr == ::1 ]] && [[ $port =~ ^[0-9]+$ ]] || return 2
        timeout 10 bash -c 'exec 3<>"/dev/tcp/$1/$2" && printf "%s\n" "$3" >&3 && sleep "$4" && printf "quit\n" >&3 && cat <&3' _ "$addr" "$port" "$command" "$wait" 2>/dev/null || return 1
    fi
}
connected_rows() {
    # name<TAB>address<TAB>connected since, one line per connected client. Fails when the interface cannot answer.
    local reply
    reply=$(mgmt_send 'status 3') || return 1
    awk -F '\t' '$1=="CLIENT_LIST" && $2!="" && $2!="UNDEF" {a=$3; sub(/:[0-9]+$/,"",a); print $2 "\t" a "\t" $8}' <<<"$reply"
}
connected_clients() {
    local rows name address since
    if ! mgmt_available; then
        info "Not available: this needs a local management interface in server.conf, and socat."
        return 0
    fi
    rows=$(connected_rows) || { fail 'The OpenVPN management interface did not answer.'; return 1; }
    if [[ -z $rows ]]; then info 'No client is connected right now.'; return 0; fi
    printf '  %s%-24s %-18s %s%s\n' "$C_BOLD" CLIENT ADDRESS SINCE "$C_RESET" || true
    while IFS=$'\t' read -r name address since; do
        printf '  %-24s %-18s %s\n' "$(safe_text "$name")" "$(safe_text "$address")" "$(safe_text "$since")" || true
    done <<<"$rows"
}
wait_for_connection() {
    # The only proof of the whole path, including the provider's firewall, which nothing here can see.
    # Returns 1 when it cannot help, so the caller pauses instead.
    local name=$1 attempt rows row address key port
    (( UI_TTY )) && mgmt_available || return 1
    port=$(server_port 2>/dev/null || printf '?')
    say
    info "Waiting for $name to connect. Press Enter to stop waiting."
    for (( attempt = 0; attempt < 200; attempt++ )); do
        rows=$(connected_rows 2>/dev/null) || rows=''
        row=$(awk -F '\t' -v n="$name" '$1==n {print; exit}' <<<"$rows")
        if [[ -n $row ]]; then
            IFS=$'\t' read -r _ address _ <<<"$row"
            ok "$name is connected from $(safe_text "$address"). The server and your provider's firewall let the VPN through."
            # The server sees the connection, not the device's internet or DNS: only the device can show those.
            info 'To check the internet too, open a website on that device.'
            pause
            return 0
        fi
        if IFS= read -r -t 3 key; then
            info 'Stopped waiting. Later, check: menu 3, Connected now.'
            return 0
        fi
    done
    warn "$name did not connect in 10 minutes. Check that UDP $port is open in your server provider's firewall."
    pause
}
mgmt_kill_client() {
    # Disconnect one CN. Returns 0 = killed, 3 = no such session, 2 = no usable interface, 1 = failed.
    local name=$1 reply rc=0
    reply=$(mgmt_send "kill $name" 1) || rc=$?
    (( rc == 0 )) || return "$rc"
    [[ $reply == *"SUCCESS: common name '$name' found"* ]] && return 0
    [[ $reply == *"ERROR: common name '$name' not found"* ]] && return 3
    printf '%s\n' "$reply" >&2 || true
    return 1
}
link_sees_connections() {
    # The link service reads the same interface itself, without socat: one local management line is enough.
    local spec addr port extra
    spec=$(awk '$1=="management" {n++; s=$2 "\t" $3 "\t" $4} END {if(n==1) print s}' "$DARBAN_SERVER_CONF" 2>/dev/null)
    [[ -n $spec ]] || return 1
    IFS=$'\t' read -r addr port extra <<<"$spec"
    [[ -z $extra ]] || return 1
    [[ $port == unix || ( ( $addr == 127.0.0.1 || $addr == localhost || $addr == ::1 ) && $port =~ ^[0-9]+$ ) ]]
}
mgmt_available() {
    # True only when mgmt_kill_client could really use it.
    local spec addr port extra
    spec=$(awk '$1=="management" {n++; s=$2 "\t" $3 "\t" $4} END {if(n==1) print s}' "$DARBAN_SERVER_CONF" 2>/dev/null)
    [[ -n $spec ]] || return 1
    IFS=$'\t' read -r addr port extra <<<"$spec"
    [[ -z $extra ]] || return 1
    if [[ $port == unix ]]; then command -v socat >/dev/null; return; fi
    [[ $addr == 127.0.0.1 || $addr == localhost || $addr == ::1 ]] && [[ $port =~ ^[0-9]+$ ]]
}
disconnect_revoked() {
    local name=$1 rc=0
    # One restart already ended every session, including those of the other names being repaired.
    if (( SESSIONS_RESTARTED )); then return 0; fi
    if ! valid_existing_name "$name"; then info "Cannot address $(safe_text "$name") through the management interface."; return 0; fi
    if ! systemctl is-active --quiet "$DARBAN_UNIT"; then warn "OpenVPN service is not active; review its status (Maintenance $S_CRUMB 1)."; return 0; fi
    info "Disconnecting any active session of $name${S_ELL}"
    mgmt_kill_client "$name" || rc=$?
    case $rc in
        0) ok "Active session of $name disconnected (other users were not affected)."; audit "session disconnected: $name"; return 0 ;;
        3) ok "$name has no active VPN session."; return 0 ;;
        1) warn 'The management interface did not confirm the disconnect.' ;;
        *) info "Single-client disconnect is unavailable. To enable it, add this to server.conf and install socat: management /run/openvpn-server/darban.sock unix" ;;
    esac
    say
    info "$name cannot start new connections. A session already open may last until it renegotiates (up to 1 hour)."
    if confirm_choice 'Restart OpenVPN now to end it? This drops ALL connected VPN users for a few seconds.' 'No, do not restart' 'Restart OpenVPN' caution; then
        info "Restarting OpenVPN${S_ELL}"
        if systemctl restart "$DARBAN_UNIT" && systemctl is-active --quiet "$DARBAN_UNIT"; then
            ok 'OpenVPN restarted.'
            SESSIONS_RESTARTED=1
            audit "OpenVPN restarted to drop revoked client: $name"
        else
            urgent 'OpenVPN restart FAILED. The CRL is published; check: journalctl -u openvpn-server@server'
        fi
    else
        info 'Not restarted.'
    fi
}
generate_and_publish_crl() {
    # generate_and_publish_crl [serial that must be listed]. On failure the previous CRL stays active.
    local must_list=${1:-}
    info "Generating and verifying a new CRL${S_ELL}"
    run_easyrsa gen-crl || { urgent 'CRL generation failed; the previous CRL stays active.'; return 1; }
    darban_verify_crl "$DARBAN_PKI/crl.pem" || { urgent 'The new CRL is invalid or incomplete; it was not published.'; return 1; }
    if [[ -n $must_list ]] && ! darban_crl_has_serial "$DARBAN_PKI/crl.pem" "$must_list"; then
        urgent 'The new CRL omits this client; it was not published.'; return 1
    fi
    darban_publish_crl "$DARBAN_PKI/crl.pem" || { urgent 'The CRL was not published; the previous CRL stays active.'; return 1; }
    ok 'New CRL published to OpenVPN and verified.'
}
revoke_and_publish() {
    local name=$1 client_serial=$2
    info "Revoking the certificate${S_ELL}"
    run_easyrsa revoke "$name" || { fail 'Easy-RSA revoke failed. Review the CA index before any retry.'; return 1; }
    [[ $(index_state_of_serial "$client_serial") == R ]] || {
        urgent 'The CA index did not mark the certificate revoked. Manual investigation required.'; return 1;
    }
    ok 'Marked revoked in the CA index.'
    audit "client revoked in the CA: $name (serial $client_serial)"
    generate_and_publish_crl "$client_serial" || {
        urgent "$name is revoked in the CA, but OpenVPN can still accept it. Do NOT assume it is blocked."
        info "After fixing the cause, finish this revocation: Maintenance $S_CRUMB 2, or: sudo darban repair-crl"
        audit "CRL not published after revoking: $name"
        return 1
    }
}
repair_crl() {
    # Finishes whatever an interrupted revocation left: the index and published files show what is
    # missing, so there is no separate state to get out of step with them.
    local pending leftovers name path publish=0 rc=0
    local -a targets=() leftover_names=()
    darban_crl_configured || { warn "server.conf lacks a single 'crl-verify $DARBAN_CRL'; OpenVPN would ignore a CRL. Fix the server first."; return 1; }
    ca_lock || return 1
    pending=$(revocation_pending_names) || { fail 'Could not read the CA index.'; return 1; }
    leftovers=$(revoked_with_profile) || { fail 'Could not read the CA index.'; return 1; }
    if ! darban_verify_crl "$DARBAN_CRL"; then publish=1; fi
    if [[ -n $pending ]]; then publish=1; fi
    if (( ! publish )) && [[ -z $leftovers ]]; then
        ok 'The CRL is healthy and no revocation is unfinished. Nothing to repair.'
        return 0
    fi
    if (( publish )); then
        critical_begin
        generate_and_publish_crl || rc=$?
        critical_end
        if (( rc != 0 )); then
            fail 'Repair failed; see the reason above. Nothing else was changed.'
            audit 'CRL repair failed'
            return 1
        fi
        audit 'CRL repaired and republished'
    fi
    if [[ -n $leftovers ]]; then mapfile -t leftover_names <<<"$leftovers"; fi
    for name in "${leftover_names[@]}"; do
        path=$OUT_DIR/$name.ovpn
        if rm -f -- "$path"; then
            ok "Server copy deleted: $path"
            audit "profile deleted from server: $path"
        else
            warn "Could not delete the server copy: $path"
        fi
    done
    ca_unlock
    # Read into an array first: the prompts in disconnect_revoked must read the terminal, not this list.
    mapfile -t targets < <(printf '%s\n' "$pending" "$leftovers" | awk 'NF' | sort -u)
    for name in "${targets[@]}"; do disconnect_revoked "$name"; done
    say
    if (( publish )); then ok 'The CRL is repaired.'; else ok 'The unfinished revocation is complete.'; fi
}
revoke_client() {
    local name state client_serial db_serial path pending unknown home_copy rc=0
    pending=$(revocation_pending_names | join_lines) || pending=''
    if [[ -n $pending ]]; then
        urgent "Revoked but NOT blocked yet: $(safe_text "$pending"). Finish this first: Maintenance $S_CRUMB 2, or: sudo darban repair-crl"
        say
    fi
    pick_client 'Revoke which client?' can_revoke revoke_block_reason || return 0
    name=$PICKED
    state=$(client_index_status "$name")
    [[ $state == V ]] || { warn "Client is not uniquely valid: ${state:-not found}"; return 1; }
    client_cert_safe "$name" || {
        warn 'Refused: this is the OpenVPN server certificate or a certificate usable for server authentication.'; return 1;
    }
    darban_crl_configured || { warn "server.conf lacks a single 'crl-verify $DARBAN_CRL'; revocation would not be enforced. Fix the server first."; return 1; }
    # Publishing would be refused after the permanent step, so a rolled-back database stops it here.
    if darban_crl_signature_ok "$DARBAN_CRL"; then
        unknown=$(darban_crl_unknown_serials "$DARBAN_CRL") || { fail 'Could not compare the CA database with the published CRL. No changes made.'; return 1; }
        if [[ -n $unknown ]]; then fail "No changes made. $(darban_rollback_hint)"; return 1; fi
    fi
    # A broken CRL must not block an emergency revocation: a complete new CRL is generated and verified below.
    if ! darban_verify_crl "$DARBAN_CRL"; then
        warn 'The published CRL is currently unhealthy; this revocation will replace it with a freshly generated, fully verified CRL.'
    fi
    client_serial=$(openssl x509 -in "$DARBAN_PKI/issued/$name.crt" -noout -serial | sed 's/^serial=//') || return 1
    db_serial=$(client_index_serial "$name")
    [[ $(darban_norm_serial "$client_serial") == "$(darban_norm_serial "$db_serial")" ]] || {
        warn 'Client certificate serial does not match the CA index. No changes made.'; return 1;
    }
    # Found now, while the certificate is still in issued/.
    home_copy=$(home_copy_of "$name") || home_copy=''
    say
    printf '%sRevoking %s is PERMANENT:%s\n' "$C_BOLD" "$name" "$C_RESET"
    bullet 'every copy of its .ovpn profile stops working for new connections'
    bullet 'this certificate can never be restored; only a new one can be issued later'
    bullet 'the server-side copy is deleted; copies on devices cannot be deleted remotely'
    say
    confirm_choice "Revoke $name permanently?" 'No, keep this client' "Revoke $name" danger "$name" || { cancelled; return 0; }
    ca_lock || return 1
    # Checked again under the lock: another session may have changed this client during the question.
    if [[ $(client_index_status "$name") != V || $(client_index_serial "$name") != "$db_serial" ]]; then
        warn "$name changed while this question was open. Nothing was revoked."
        return 1
    fi
    say
    critical_begin
    revoke_and_publish "$name" "$client_serial" || rc=$?
    critical_end
    remove_links_for "$name"
    (( rc == 0 )) || return 1
    if path=$(profile_path "$name"); then
        if rm -f -- "$path"; then ok "Server copy deleted: $path"; else warn 'Could not delete the server copy; the revocation still succeeded.'; fi
    fi
    delete_home_copy "$home_copy"
    ca_unlock
    disconnect_revoked "$name"
    say
    ok "$name is revoked."
}
port_listening() {
    # UDP socket existence plus separate systemd active check below; provider firewall must be tested externally.
    [[ -n $(ss -H -lun "sport = :$1" 2>/dev/null) ]]
}
wait_for_port() {
    local port=$1 attempt
    for attempt in 1 2 3 4 5; do
        if systemctl is-active --quiet "$DARBAN_UNIT" && port_listening "$port"; then return 0; fi
        sleep 1
    done
    return 1
}
host_firewall_check() {
    # Read-only hint: the manager never edits host firewall rules.
    local old=$1 new=$2 status rules
    if command -v ufw >/dev/null && status=$(ufw status 2>/dev/null) && [[ $status == *'Status: active'* ]]; then
        if ! grep -Eq "^$new(/udp)?[[:space:]]" <<<"$status"; then
            warn "ufw is active and has no rule for $new/udp (ufw allow $new/udp)."
        fi
    fi
    if command -v nft >/dev/null && rules=$(nft list ruleset 2>/dev/null); then
        if grep -Eq "dport[^;]*\\b$old\\b" <<<"$rules" && ! grep -Eq "dport[^;]*\\b$new\\b" <<<"$rules"; then
            warn "Host nftables rules reference port $old but not $new; traffic to the new port may be filtered or not forwarded."
        fi
    fi
}
apply_port_change() {
    local old=$1 new=$2 backup=$3 temp
    temp=$(mktemp "$DARBAN_SERVER_DIR/.darban-serverconf.XXXXXXXX") || return 1
    darban_tmp_register "$temp"
    if ! awk -v p="$new" '$1=="port" {$0="port "p} {print}' "$DARBAN_SERVER_CONF" >"$temp"; then
        rm -f -- "$temp"
        fail 'Failed to write server.conf; the original is unchanged.'
        return 1
    fi
    apply_server_conf "$temp" "$old" "$new" "$backup"
}
apply_server_conf() {
    # Puts a prepared file in place of server.conf, restarts OpenVPN, and restores the backup if it does not
    # come back. Returns 0 = applied, 1 = the previous configuration is running again, 2 = the rollback failed.
    local temp=$1 old=$2 new=$3 backup=$4
    if ! chmod --reference="$DARBAN_SERVER_CONF" "$temp" || ! chown --reference="$DARBAN_SERVER_CONF" "$temp" ||
       ! mv -f -- "$temp" "$DARBAN_SERVER_CONF"; then
        rm -f -- "$temp"
        fail 'Failed to write server.conf; the original is unchanged.'
        return 1
    fi
    ok "server.conf updated (backup: $backup)."
    info "Restarting OpenVPN and waiting for UDP $new (up to 5 seconds)${S_ELL}"
    if ! systemctl restart "$DARBAN_UNIT" || ! wait_for_port "$new"; then
        warn "OpenVPN did not come up on UDP $new. Restoring the previous server.conf${S_ELL}"
        cp -a -- "$backup" "$DARBAN_SERVER_CONF" || { urgent "Could not restore server.conf from $backup."; return 2; }
        if systemctl restart "$DARBAN_UNIT" && wait_for_port "$old"; then
            ok "Rolled back: OpenVPN is listening on UDP $old with the previous configuration."
            audit "server.conf change failed; rolled back (UDP $old)"
        else
            urgent 'Rollback restart or the previous UDP listener FAILED. Check the OpenVPN service immediately.'
            return 2
        fi
        return 1
    fi
}
prune_port_backups() {
    # Timestamped names sort chronologically; keep only the newest few.
    local excess
    local -a backups
    mapfile -t backups < <(find "$DARBAN_SERVER_DIR" -maxdepth 1 -type f -name "${DARBAN_SERVER_CONF##*/}.darban-*backup.*" -print | sort)
    excess=$(( ${#backups[@]} - PORT_BACKUPS_KEPT ))
    (( excess > 0 )) || return 0
    rm -f -- "${backups[@]:0:excess}"
}
change_port() {
    local old new backup rc=0
    old=$(server_port) || { warn 'Expected exactly one port directive in server.conf.'; return 1; }
    server_proto_ok || { warn 'Only udp4 OpenVPN servers are supported.'; return 1; }
    systemctl is-active --quiet "$DARBAN_UNIT" || { warn 'OpenVPN service is not active. Refusing to change port.'; return 1; }
    kv Current "$old/UDP"
    say
    while :; do
        prompt_valid 'New UDP port, 1024-65535 (Enter = cancel): ' valid_port 'Enter a number from 1024 to 65535.' || return 0
        new=$((10#$REPLY))
        if [[ $new == "$old" ]]; then info 'Same as the current port; nothing changed.'; return 0; fi
        if port_listening "$new"; then warn "UDP $new is already used by another program. Choose another port."; continue; fi
        break
    done
    host_firewall_check "$old" "$new"
    say
    printf '%sWhat happens next:%s\n' "$C_BOLD" "$C_RESET"
    bullet 'OpenVPN restarts: all VPN users are disconnected for a few seconds'
    bullet "if UDP $new is not up within 5 seconds, the previous configuration is restored"
    bullet 'every downloaded .ovpn must be shared again (menu 5)'
    warn "Open UDP $new in your provider firewall BEFORE continuing; this tool cannot check it."
    say
    confirm_choice "Apply UDP port $new now?" 'No, keep the current port' "Apply port $new" caution "$new" || { cancelled; return 0; }
    ca_lock || return 1
    # The file may have changed during the question.
    old=$(server_port) || { warn 'Expected exactly one port directive in server.conf.'; return 1; }
    backup="$DARBAN_SERVER_CONF.darban-backup.$(date -u +%Y%m%dT%H%M%S.%N)"
    cp -a -- "$DARBAN_SERVER_CONF" "$backup" || return 1
    critical_begin
    apply_port_change "$old" "$new" "$backup" || rc=$?
    critical_end
    if (( rc == 2 )); then fail "The rollback did not finish, so the service may be down. server.conf now has: $(server_port 2>/dev/null || printf 'no single port')"; return 1; fi
    if (( rc != 0 )); then fail "The port was NOT changed."; return 1; fi
    prune_port_backups || warn 'Could not prune old server.conf port backups.'
    audit "OpenVPN port changed: $old -> $new"
    say
    ok "OpenVPN is running and listening on UDP $new."
    info 'Test from a real remote client: local checks cannot prove the provider firewall lets traffic through.'
    info 'Share profiles again (menu 5) so clients use the new port.'
}
# ---------- advanced settings ----------
conf_value() { awk -v k="$1" '$1==k {$1=""; sub(/^ /,""); v=$0} END {print v}' "$DARBAN_SERVER_CONF"; }
conf_full_tunnel() { grep -Eq '^[[:space:]]*push[[:space:]]+"redirect-gateway' "$DARBAN_SERVER_CONF"; }
conf_dns() {
    awk '$1=="push" && $2=="\"dhcp-option" && $3=="DNS" {gsub(/"/,"",$4); s = s (s == "" ? "" : " ") $4} END {print s}' "$DARBAN_SERVER_CONF"
}
conf_ready() {
    # A change restarts the service, so it needs a healthy starting point and a known port to check.
    server_port >/dev/null || { warn 'Expected exactly one port directive in server.conf.'; return 1; }
    systemctl is-active --quiet "$DARBAN_UNIT" || { warn 'OpenVPN service is not active; fix that first (Maintenance).'; return 1; }
}
restart_notice() {
    bullet 'OpenVPN restarts: connected users drop for a few seconds and reconnect by themselves'
    bullet 'if it does not come back, the previous configuration is restored'
}
conf_apply() {
    # conf_apply <description> <prepared file>: applies it with a backup, a restart and a rollback.
    local description=$1 temp=$2 port backup rc=0
    port=$(server_port) || return 1
    backup="$DARBAN_SERVER_CONF.darban-backup.$(date -u +%Y%m%dT%H%M%S.%N)"
    cp -a -- "$DARBAN_SERVER_CONF" "$backup" || return 1
    critical_begin
    apply_server_conf "$temp" "$port" "$port" "$backup" || rc=$?
    critical_end
    if (( rc == 2 )); then fail 'The rollback did not finish, so the service may be down.'; return 2; fi
    if (( rc != 0 )); then fail 'Nothing was changed.'; return 1; fi
    prune_port_backups || warn 'Could not prune old server.conf backups.'
    audit "server.conf changed: $description"
    ok "Applied: $description. OpenVPN is listening on UDP $port."
}
conf_set_directive() {
    # conf_set_directive <key> <value> <output>: one line for the key, in its old place or at the end.
    awk -v k="$1" -v v="$2" '$1==k {if (!done) print k " " v; done=1; next} {print} END {if (!done) print k " " v}' "$DARBAN_SERVER_CONF" >"$3"
}
new_conf_file() {
    # Taken before the file is read, so the change starts from the current configuration.
    ca_lock || return 1
    CONF_TEMP=$(mktemp "$DARBAN_SERVER_DIR/.darban-serverconf.XXXXXXXX") || return 1
    darban_tmp_register "$CONF_TEMP"
}
set_routing() {
    local dns item
    conf_ready || return 1
    if conf_full_tunnel; then
        kv Current 'full tunnel: all client IPv4 traffic goes through the VPN'
        say
        restart_notice
        bullet 'clients keep their own internet path and DNS'
        say
        confirm_choice 'Switch to split tunnel?' 'No, keep the full tunnel' 'Switch to split tunnel' caution split || { cancelled; return 0; }
        new_conf_file || return 1
        awk '!($1=="push" && ($2=="\"redirect-gateway" || ($2=="\"dhcp-option" && $3=="DNS")))' "$DARBAN_SERVER_CONF" >"$CONF_TEMP"
        conf_apply 'split tunnel' "$CONF_TEMP"
        return
    fi
    kv Current 'split tunnel: only traffic for the VPN network'
    say
    restart_notice
    bullet "clients send all IPv4 traffic through this server; DNS: $DEFAULT_CLIENT_DNS unless already set"
    warn 'The server must do NAT for the VPN network, or clients lose their internet.'
    say
    confirm_choice 'Switch to full tunnel?' 'No, keep the split tunnel' 'Switch to full tunnel' caution full || { cancelled; return 0; }
    dns=$(conf_dns)
    new_conf_file || return 1
    cat -- "$DARBAN_SERVER_CONF" >"$CONF_TEMP"
    printf 'push "redirect-gateway def1 bypass-dhcp"\n' >>"$CONF_TEMP"
    if [[ -z $dns ]]; then
        for item in $DEFAULT_CLIENT_DNS; do printf 'push "dhcp-option DNS %s"\n' "$item" >>"$CONF_TEMP"; done
    fi
    conf_apply 'full tunnel' "$CONF_TEMP"
}
set_dns() {
    local item current DNS_LIST=''
    conf_ready || return 1
    if ! conf_full_tunnel; then
        info 'In a split tunnel, clients keep their own DNS. Switch to the full tunnel first (item 1).'
        return 0
    fi
    current=$(conf_dns)
    kv Current "${current:-none pushed}"
    say
    prompt_valid 'New DNS servers, one or two IPv4 addresses (Enter = cancel): ' valid_dns 'Enter one or two IPv4 addresses, such as 1.1.1.1 8.8.8.8.' || return 0
    if [[ $DNS_LIST == "$current" ]]; then info 'Same as the current DNS; nothing changed.'; return 0; fi
    say
    restart_notice
    say
    confirm_choice "Use $DNS_LIST for clients?" 'No, keep the current DNS' 'Apply and restart OpenVPN' caution "$DNS_LIST" || { cancelled; return 0; }
    new_conf_file || return 1
    awk '!($1=="push" && $2=="\"dhcp-option" && $3=="DNS")' "$DARBAN_SERVER_CONF" >"$CONF_TEMP"
    for item in $DNS_LIST; do printf 'push "dhcp-option DNS %s"\n' "$item" >>"$CONF_TEMP"; done
    conf_apply "DNS $DNS_LIST" "$CONF_TEMP"
}
set_vpn_network() {
    local current mask candidate clash nat=$CONFIG_DIR/nat.nft nat_saved rc=0
    conf_ready || return 1
    read -r current mask < <(awk '$1=="server" {print $2, $3; exit}' "$DARBAN_SERVER_CONF") || true
    if ! valid_ipv4 "${current:-}" || [[ ${mask:-} != 255.255.255.0 ]]; then
        warn "This option works with a single 'server A.B.C.0 255.255.255.0' line in server.conf; this server has another layout."
        return 1
    fi
    if [[ ! -f $nat ]]; then
        warn "NAT on this server was not set up by this tool, so it cannot follow a new network. Change server.conf and NAT together by hand."
        return 1
    fi
    kv Current "$current/24"
    say
    prompt_valid 'New VPN network, a private /24 ending in .0 (Enter = cancel): ' valid_subnet 'Enter a private network ending in .0, such as 10.9.0.0.' || return 0
    candidate=$REPLY
    if [[ $candidate == "$current" ]]; then info 'Same as the current network; nothing changed.'; return 0; fi
    if clash=$(subnet_conflict "$candidate"); then warn "$candidate/24 overlaps the existing route $clash. Nothing changed."; return 1; fi
    say
    restart_notice
    bullet 'clients get new VPN addresses when they reconnect; their .ovpn files stay valid'
    if grep -Eq '^[[:space:]]*(client-config-dir|ifconfig-pool-persist)[[:space:]]' "$DARBAN_SERVER_CONF"; then
        warn 'Fixed client addresses (client-config-dir, ifconfig-pool-persist) are not updated. Check them afterwards.'
    fi
    say
    confirm_choice "Move the VPN to $candidate/24?" 'No, keep the current network' 'Apply and restart OpenVPN' caution "$candidate" || { cancelled; return 0; }
    ca_lock || return 1
    # Everything is prepared before anything changes. Then NAT and server.conf change together, or not at all,
    # and Ctrl+C cannot stop it in between.
    new_conf_file || return 1
    conf_set_directive server "$candidate 255.255.255.0" "$CONF_TEMP" || { fail 'Could not prepare server.conf. Nothing was changed.'; return 1; }
    nat_saved=$(mktemp) || return 1
    darban_tmp_register "$nat_saved"
    cp -- "$nat" "$nat_saved" || return 1
    critical_begin
    # nft loads a whole file in one transaction, so a refused file leaves the running rules as they were.
    if ! sed -i "s#$current/24#$candidate/24#g" "$nat" || ! nft -f "$nat"; then
        cp -- "$nat_saved" "$nat" || true
        critical_end
        fail 'Could not load the new NAT rule. Nothing was changed.'
        return 1
    fi
    conf_apply "VPN network $candidate/24" "$CONF_TEMP" || rc=$?
    if (( rc != 0 )); then
        cp -- "$nat_saved" "$nat" || true
        nft -f "$nat" || urgent 'Could not restore the previous NAT rule. Check: nft list ruleset'
        critical_end
        return 1
    fi
    critical_end
}
valid_ciphers() {
    # AEAD ciphers only: anything else would turn DCO off.
    local item
    local -a items
    IFS=: read -r -a items <<<"$1"
    (( ${#items[@]} > 0 )) || return 1
    for item in "${items[@]}"; do
        case $item in AES-128-GCM|AES-256-GCM|CHACHA20-POLY1305) ;; *) return 1 ;; esac
    done
}
set_ciphers() {
    local current
    conf_ready || return 1
    current=$(conf_value data-ciphers)
    kv Current "${current:-OpenVPN default}"
    info 'Allowed: AES-256-GCM, AES-128-GCM, CHACHA20-POLY1305. Others would turn off DCO.'
    say
    prompt_valid 'New list, separated by colons (Enter = cancel): ' valid_ciphers 'Use only the allowed names, separated by colons.' || return 0
    if [[ $REPLY == "$current" ]]; then info 'Same as the current list; nothing changed.'; return 0; fi
    local value=$REPLY
    say
    restart_notice
    warn 'Clients whose .ovpn has no cipher in common with the new list cannot connect until shared again (menu 5).'
    say
    confirm_choice "Use $value?" 'No, keep the current ciphers' 'Apply and restart OpenVPN' caution "$value" || { cancelled; return 0; }
    new_conf_file || return 1
    conf_set_directive data-ciphers "$value" "$CONF_TEMP"
    conf_apply "data ciphers $value" "$CONF_TEMP"
}
valid_keepalive() {
    local interval timeout extra
    read -r interval timeout extra <<<"$1"
    [[ -z $extra && $interval =~ ^[0-9]{1,3}$ && $timeout =~ ^[0-9]{1,4}$ ]] || return 1
    (( 10#$interval >= 1 && 10#$timeout >= 2 * 10#$interval ))
}
set_keepalive() {
    local value
    conf_ready || return 1
    kv Current "$(conf_value keepalive)"
    info 'Two numbers in seconds: how often to ping, and when to give up. The second must be at least twice the first.'
    say
    prompt_valid 'New keepalive, such as 10 60 (Enter = cancel): ' valid_keepalive 'Enter two numbers, such as 10 60; the second at least twice the first.' || return 0
    value=$(printf '%s' "$REPLY" | awk '{print $1, $2}')
    say
    restart_notice
    say
    confirm_choice "Use keepalive $value?" 'No, keep the current value' 'Apply and restart OpenVPN' caution "$value" || { cancelled; return 0; }
    new_conf_file || return 1
    conf_set_directive keepalive "$value" "$CONF_TEMP"
    conf_apply "keepalive $value" "$CONF_TEMP"
}
valid_verb() { [[ $1 =~ ^[0-9]$ ]] && (( $1 <= 6 )); }
set_verb() {
    local value
    conf_ready || return 1
    kv Current "$(conf_value verb)"
    info '3 is normal. 4 or more shows more detail, can log private details, and is only for troubleshooting.'
    say
    prompt_valid 'New log detail, 0 to 6 (Enter = cancel): ' valid_verb 'Enter a number from 0 to 6.' || return 0
    value=$REPLY
    say
    restart_notice
    say
    confirm_choice "Use log detail $value?" 'No, keep the current value' 'Apply and restart OpenVPN' caution "$value" || { cancelled; return 0; }
    new_conf_file || return 1
    conf_set_directive verb "$value" "$CONF_TEMP"
    conf_apply "log detail $value" "$CONF_TEMP"
}
save_config() {
    # Unknown lines are kept; only the settings this tool owns are rewritten.
    local temp held=$CA_LOCKED
    ca_lock || return 1
    temp=$(mktemp "$CONFIG_DIR/.config.XXXXXXXX") || return 1
    darban_tmp_register "$temp"
    if [[ -f $CONFIG_FILE ]]; then
        awk -F= '$1!="DOWNLOAD_SSH_HOST" && $1!="DOWNLOAD_SSH_PORT" && $1!="DOWNLOAD_SSH_USER" && $1!="CLIENT_CERT_DAYS" && $1!="LINK_PORT" && $1!="LINK_HOURS" && $1!="UPDATE_CHECK"' "$CONFIG_FILE" >"$temp" || return 1
    fi
    printf 'DOWNLOAD_SSH_HOST=%s\nDOWNLOAD_SSH_PORT=%s\nDOWNLOAD_SSH_USER=%s\n' "$DOWNLOAD_SSH_HOST" "$DOWNLOAD_SSH_PORT" "$DOWNLOAD_SSH_USER" >>"$temp" || return 1
    if [[ -n $CLIENT_CERT_DAYS ]]; then printf 'CLIENT_CERT_DAYS=%s\n' "$CLIENT_CERT_DAYS" >>"$temp" || return 1; fi
    if [[ -n $LINK_PORT ]]; then printf 'LINK_PORT=%s\n' "$LINK_PORT" >>"$temp" || return 1; fi
    if [[ -n $LINK_HOURS ]]; then printf 'LINK_HOURS=%s\n' "$LINK_HOURS" >>"$temp" || return 1; fi
    if [[ $UPDATE_CHECK == no ]]; then printf 'UPDATE_CHECK=no\n' >>"$temp" || return 1; fi
    chmod 600 "$temp" && mv -f -- "$temp" "$CONFIG_FILE" || return 1
    if (( ! held )); then ca_unlock; fi
}
valid_ssh_host() { valid_ipv4 "$1" || valid_domain "$1"; }
valid_ssh_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_ssh_user() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
set_download_access() {
    local host=$DOWNLOAD_SSH_HOST port=$DOWNLOAD_SSH_PORT user=$DOWNLOAD_SSH_USER
    info 'Only the scp and sftp commands shown after creating a client use these. No restart is needed.'
    say
    while :; do
        ask "SSH address${host:+ [$host]} (Enter = keep): " || { cancelled; return 0; }
        if [[ -n $REPLY ]]; then host=$REPLY; fi
        if valid_ssh_host "$host"; then break; fi
        warn 'Enter a hostname or an IPv4 address.'; host=$DOWNLOAD_SSH_HOST
    done
    while :; do
        ask "SSH port [$port] (Enter = keep): " || { cancelled; return 0; }
        if [[ -n $REPLY ]]; then port=$REPLY; fi
        if valid_ssh_port "$port"; then break; fi
        warn 'Enter a number from 1 to 65535.'; port=$DOWNLOAD_SSH_PORT
    done
    while :; do
        ask "SSH user [$user] (Enter = keep): " || { cancelled; return 0; }
        if [[ -n $REPLY ]]; then user=$REPLY; fi
        if valid_ssh_user "$user"; then break; fi
        warn 'Enter a valid Linux user name.'; user=$DOWNLOAD_SSH_USER
    done
    if [[ $user != root ]]; then info "$OUT_DIR is readable by root only, so $user gets a private copy of a profile when it is shared."; fi
    DOWNLOAD_SSH_HOST=$host DOWNLOAD_SSH_PORT=$port DOWNLOAD_SSH_USER=$user
    save_config || { fail 'Could not save the settings.'; return 1; }
    audit "download access changed: $user@$host:$port"
    ok "Saved: $user@$host:$port"
}
set_client_days() {
    kv Current "${CLIENT_CERT_DAYS:-Easy-RSA default}"
    info 'Applies only to clients created from now on. Certificates are not renewed automatically.'
    say
    if ! ask 'Days a new client certificate lasts, 1 to 3650; 0 = Easy-RSA default (Enter = cancel): ' || [[ -z $REPLY ]]; then cancelled; return 0; fi
    if [[ $REPLY == 0 ]]; then
        CLIENT_CERT_DAYS=''
    elif valid_client_days "$REPLY"; then
        CLIENT_CERT_DAYS=$((10#$REPLY))
    else
        warn 'Enter a number from 0 to 3650. Nothing changed.'
        return 1
    fi
    save_config || { fail 'Could not save the settings.'; return 1; }
    audit "new client lifetime changed: ${CLIENT_CERT_DAYS:-default}"
    ok "New clients last: ${CLIENT_CERT_DAYS:-Easy-RSA default} ${CLIENT_CERT_DAYS:+days}"
}
set_link_hours() {
    kv Current "$(hours_label "$(link_hours)")"
    info 'The longest time a temporary link works. It usually ends sooner, about 10 seconds after a connection with its profile is seen.'
    say
    prompt_valid 'Hours, 1 to 72 (Enter = cancel): ' valid_link_hours 'Enter a whole number of hours from 1 to 72.' || return 0
    LINK_HOURS=$((10#$REPLY))
    save_config || { fail 'Could not save the setting.'; return 1; }
    audit "link lifetime changed: $LINK_HOURS hours"
    ok "Saved: links work for at most $(hours_label "$LINK_HOURS"). It applies from the next link."
}
set_link_port() {
    kv Current "$(link_port_summary)"
    info 'TCP port of temporary links. It must be open in your provider firewall.'
    say
    prompt_valid 'New port, 1 to 65535 (Enter = cancel): ' valid_link_port 'Enter a number from 1 to 65535.' || return 0
    if tcp_port_taken "$((10#$REPLY))"; then
        warn "TCP $((10#$REPLY)) is already used by $(safe_text "$(tcp_port_program "$((10#$REPLY))")"). Nothing changed."
        return 1
    fi
    LINK_PORT=$((10#$REPLY))
    save_config || { fail 'Could not save the setting.'; return 1; }
    audit "share link port changed: $LINK_PORT"
    ok "Saved: TCP $LINK_PORT. It applies from the next link."
}
restart_openvpn() {
    local state port rc=0
    state=$(systemctl is-active "$DARBAN_UNIT" 2>/dev/null || true)
    kv Service "${state:-unknown}"
    say
    info 'Creating and revoking clients do not need a restart.'
    info 'Use this after editing server.conf by hand, or when the service has stopped.'
    say
    confirm_choice 'Restart OpenVPN now? This drops ALL connected VPN users for a few seconds.' 'No, do not restart' 'Restart OpenVPN' caution restart || { cancelled; return 0; }
    ca_lock || return 1
    info "Restarting OpenVPN${S_ELL}"
    port=$(server_port 2>/dev/null) || port=''
    critical_begin
    systemctl restart "$DARBAN_UNIT" || rc=$?
    if (( rc == 0 )); then
        if [[ -n $port ]]; then
            wait_for_port "$port" || rc=1
        else
            systemctl is-active --quiet "$DARBAN_UNIT" || rc=1
        fi
    fi
    critical_end
    if (( rc != 0 )); then
        urgent "OpenVPN did not come back up${port:+ on UDP $port}. Check: journalctl -u $DARBAN_UNIT -n 50 --no-pager"
        audit 'OpenVPN restart from the menu FAILED'
        return 1
    fi
    audit 'OpenVPN restarted from the menu'
    if [[ -n $port ]]; then
        ok "OpenVPN is running and listening on UDP $port."
    else
        ok 'OpenVPN is running.'
        warn 'Could not read a single port from server.conf, so the UDP listener was not checked.'
    fi
}
valid_version() { [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$ ]]; }
version_is_newer() {
    # version_is_newer A B: true when A is newer. sort -V alone would put 1.0.0-rc.1 after 1.0.0.
    local a=$1 b=$2 base_a=${1%%-*} base_b=${2%%-*}
    [[ $a != "$b" ]] || return 1
    if [[ $base_a != "$base_b" ]]; then
        [[ $(printf '%s\n%s\n' "$base_a" "$base_b" | sort -V | tail -n 1) == "$base_a" ]]
        return
    fi
    # The same base: a final release is newer than any pre-release of it.
    if [[ $a == "$base_a" ]]; then return 0; fi
    if [[ $b == "$base_b" ]]; then return 1; fi
    [[ $(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n 1) == "$a" ]]
}
latest_release_version() {
    # A final version is offered only final versions. A test version follows test versions too, so a release
    # candidate can be updated to the next one, and then to the final version.
    if [[ $DARBAN_VERSION == *-* ]]; then newest_release_version; return; fi
    curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --max-time 20 "$DARBAN_URL/releases/latest/download/VERSION"
}
newest_release_version() {
    # The highest version among the published releases, test versions included. GitHub lists no drafts here.
    local list tag newest=''
    list=$(curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --max-time 20 \
        "https://api.github.com/repos/$DARBAN_REPO/releases?per_page=20") || return
    while IFS= read -r tag; do
        tag=${tag#v}
        valid_version "$tag" || continue
        if [[ -z $newest ]] || version_is_newer "$tag" "$newest"; then newest=$tag; fi
    done < <(grep -o '"tag_name": *"v[^"]*"' <<<"$list" | sed 's/^.*"\(v[^"]*\)"$/\1/')
    [[ -n $newest ]] || return 22
    printf '%s\n' "$newest"
}
start_update_check() {
    # In the background and at most once a day, so the menu never waits for the network.
    [[ $UPDATE_CHECK == yes ]] || return 0
    command -v curl >/dev/null || return 0
    if [[ -n $(find "$UPDATE_CACHE" -mmin -1440 2>/dev/null) ]]; then return 0; fi
    (
        latest=$(latest_release_version) || latest=''
        if valid_version "$latest"; then
            temp=$(mktemp "$UPDATE_CACHE.XXXXXX") && printf '%s\n' "$latest" >"$temp" && mv -f -- "$temp" "$UPDATE_CACHE"
        else
            # Remember the attempt too, so a server without internet does not retry on every start.
            touch -- "$UPDATE_CACHE"
        fi
    ) >/dev/null 2>&1 </dev/null &
    disown
}
available_update() {
    # Prints a newer version known from the last check; nothing otherwise.
    local cached=''
    [[ $UPDATE_CHECK == yes && -s $UPDATE_CACHE ]] || return 0
    IFS= read -r cached <"$UPDATE_CACHE" || true
    if valid_version "$cached" && version_is_newer "$cached" "$DARBAN_VERSION"; then printf '%s\n' "$cached"; fi
}
show_release_notes() {
    # Escape sequences are removed: this text comes from the network and goes straight to a root terminal.
    local notes
    notes=$(curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --max-time 20 "$DARBAN_URL/releases/download/v$1/RELEASE-NOTES.txt" 2>/dev/null | LC_ALL=C tr -d '\000-\010\013-\037\177') || notes=''
    say
    if [[ -n $notes ]]; then
        printf '%sWhat is new in v%s:%s\n' "$C_BOLD" "$1" "$C_RESET" || true
        printf '%s\n' "$notes" | head -n 25
    else
        info "Release notes: $DARBAN_URL/releases/tag/v$1"
    fi
}
update_tool() {
    local latest rc=0
    command -v curl >/dev/null || { fail 'curl is required to check for updates.'; return 1; }
    kv Installed "v$DARBAN_VERSION"
    info "Checking the latest release of $DARBAN_REPO${S_ELL}"
    # curl's own error line would read like a failure, and the message below says what it means.
    latest=$(latest_release_version 2>/dev/null) || rc=$?
    # curl reports an HTTP error as 22: GitHub answered, and no stable release is there.
    if (( rc == 22 )); then
        ok "v$DARBAN_VERSION is up to date. No stable release is published yet."
        info "Releases: $DARBAN_URL/releases"
        return 0
    fi
    if (( rc != 0 )); then fail 'Could not reach GitHub. Check the internet connection of this server.'; return 1; fi
    valid_version "$latest" || { fail 'The release does not state a valid version.'; return 1; }
    kv Latest "v$latest"
    if ! version_is_newer "$latest" "$DARBAN_VERSION"; then
        ok 'This is the latest version.'
        return 0
    fi
    show_release_notes "$latest"
    say
    info 'Only this tool is replaced. OpenVPN is not restarted, and clients, the PKI and the CRL stay as they are.'
    say
    confirm_choice "Install v$latest now?" 'No, keep this version' "Install v$latest" caution "$latest" || { cancelled; return 0; }
    bash "$DARBAN_LIB/get.sh" --version "v$latest" || { fail 'The update failed. See the messages above.'; audit "update to v$latest failed"; return 1; }
    audit "updated: v$DARBAN_VERSION -> v$latest"
    say
    ok "Updated to v$latest. Start it again: $(cmd sudo darban)"
    exit "$RC_QUIT"
}
restore_previous() {
    # Backups are named by time, so the last one is what the latest update replaced.
    local newest='' dir version
    if [[ -d $BACKUP_ROOT ]]; then
        for dir in "$BACKUP_ROOT"/*; do
            if [[ -f $dir/sbin/darban ]]; then newest=$dir; fi
        done
    fi
    if [[ -z $newest ]]; then info 'No previous version is stored on this server.'; return 0; fi
    version=$(awk -F= '$1=="DARBAN_VERSION" {print $2; exit}' "$newest/sbin/darban")
    kv Installed "v$DARBAN_VERSION"
    kv Previous "v${version:-unknown}"
    say
    info 'Only this tool is replaced. OpenVPN is not restarted, and clients, the PKI and the CRL stay as they are.'
    say
    confirm_choice "Go back to v${version:-unknown}?" 'No, keep this version' 'Restore the previous version' caution restore || { cancelled; return 0; }
    ca_lock || return 1
    critical_begin
    cp -a -- "$newest/sbin/." "$SBIN_DIR/" && cp -a -- "$newest/lib/." "$DARBAN_LIB/" && cp -a -- "$newest/units/." "$UNIT_DIR/" || {
        critical_end
        urgent "The restore did not finish. The files are in $newest."
        return 1
    }
    systemctl daemon-reload
    rm -rf -- "$newest"
    critical_end
    audit "restored previous version: v$DARBAN_VERSION -> v${version:-unknown}"
    ok "Restored v${version:-unknown}. Start it again: $(cmd sudo darban)"
    exit "$RC_QUIT"
}
toggle_update_notice() {
    if [[ $UPDATE_CHECK == yes ]]; then UPDATE_CHECK=no; else UPDATE_CHECK=yes; fi
    save_config || { fail 'Could not save the setting.'; return 1; }
    if [[ $UPDATE_CHECK == yes ]]; then
        ok 'The menu now looks for new releases once a day. Nothing is installed without your confirmation.'
    else
        rm -f -- "$UPDATE_CACHE"
        ok 'The menu no longer looks for new releases. "Check for updates" still works.'
    fi
}
about_text() {
    say "Darban OVPN v$DARBAN_VERSION"
    say 'OpenVPN server manager for Ubuntu 24.04 and 26.04'
    say
    say "  GitHub   $DARBAN_URL"
    say "  Email    $DARBAN_EMAIL"
    say '  License  MIT'
    say
    say 'Not affiliated with OpenVPN Inc.'
}
uninstall_tool() {
    local expiry=''
    if expiry=$(darban_crl_expiry_epoch "$DARBAN_CRL" 2>/dev/null); then expiry=$(date -u -d "@$expiry" +%Y-%m-%d); else expiry=unknown; fi
    printf '%sThis removes the tool, its menu and its daily CRL renewal.%s\n' "$C_BOLD" "$C_RESET"
    bullet 'OpenVPN, connected users, the PKI, the CRL and server.conf are not touched'
    bullet "$OUT_DIR and $CONFIG_DIR are kept"
    warn "Nothing will renew the CRL after this. It expires on $expiry; renew it yourself before then, or OpenVPN may refuse clients."
    say
    confirm_choice 'Uninstall Darban OVPN?' 'No, keep it' 'Uninstall' danger uninstall || { cancelled; return 0; }
    ca_lock || return 1
    audit 'tool uninstalled'
    bash "$DARBAN_LIB/uninstall.sh" --yes || { fail 'The uninstall did not finish. See the messages above.'; return 1; }
    exit "$RC_QUIT"
}
remove_everything() {
    local status
    local -a options=()
    if [[ ! -e $CONFIG_DIR/.server-setup-started ]]; then
        fail 'OpenVPN on this server was not set up by this tool, so it will not be removed. "Uninstall this tool only" is available.'
        return 1
    fi
    printf '%sThis permanently removes the tool, OpenVPN, the CA, every client certificate and every .ovpn file.%s\n' "$C_BOLD" "$C_RESET"
    bullet 'all VPN users are disconnected now'
    bullet 'every .ovpn file stops working for good, even if OpenVPN is installed again later'
    bullet 'a session reaching this server through this VPN ends too; use direct SSH'
    bullet 'packages are removed only if the setup added them and nothing else needs them'
    say
    # Option 1 is the safe default, so anything but an explicit "No backup" keeps one.
    if confirm_choice 'Keep a backup of the CA, configuration and profiles first?' 'Yes, keep a backup in /root' 'No backup' danger; then
        info 'No backup will be made.'
    else
        options+=(--backup)
    fi
    say
    status=$(bash "$DARBAN_LIB/remove-server.sh" --kernel-status) || status=none
    case $status in
        running) info 'The Virtual HWE kernel stays: the system is running it now.' ;;
        removable)
            if confirm_choice 'Also remove the Virtual HWE kernel the setup installed?' 'No, keep it' 'Remove the kernel' danger; then
                options+=(--kernel)
            fi ;;
    esac
    say
    confirm_choice 'Remove everything now? This cannot be undone.' 'No, keep everything' 'Remove everything' danger remove-everything || { cancelled; return 0; }
    ca_lock || return 1
    audit 'removing the tool, OpenVPN, the CA and all profiles'
    bash "$DARBAN_LIB/remove-server.sh" --yes "${options[@]}" || { fail 'The removal did not finish. See the messages above.'; return 1; }
    exit "$RC_QUIT"
}
check() {
    # check <ok|bad|warn|info> <text>: one line of the diagnostics checklist.
    local symbol=$S_INFO color=''
    case $1 in
        ok) symbol=$S_OK color=$C_GREEN ;;
        bad) symbol=$S_BAD color=$C_RED HEALTH_BAD=$((HEALTH_BAD + 1)) ;;
        warn) symbol=$S_WARN color=$C_YELLOW ;;
    esac
    printf '  %s%s%s %s\n' "$color" "$symbol" "$C_RESET" "$(with_action "$2")" || true
}
group() { printf '\n %s%s%s\n' "$C_GROUP" "$1" "$C_RESET" || true; }
check_expiry() {
    # check_expiry <label> <epoch>
    if (( $2 <= $(date -u +%s) )); then check bad "$1 EXPIRED on $(date -u -d "@$2" +%Y-%m-%d)"
    elif (( $(days_until "$2") <= EXPIRY_WARN_DAYS )); then check warn "$1 valid until $(describe_expiry "$2") $S_ARROW renew soon (not automated)"
    else check ok "$1 valid until $(describe_expiry "$2")"; fi
}
network_rules_health() {
    # What the kernel runs now is checked, not what a file says: a flushed chain or an old network must not pass.
    local net nat=$CONFIG_DIR/nat.nft fix reinstall live_iface route_iface
    if ! nft list table ip darban >/dev/null 2>&1; then
        if [[ -f $nat ]]; then
            check bad "The NAT rules of this tool are not loaded $S_ARROW sudo systemctl restart darban-nat.service"
        else
            check info 'NAT table of this tool not found; NAT may be managed elsewhere'
        fi
        return 0
    fi
    net=$(darban_conf_net)
    if ! valid_ipv4 "${net:-}"; then
        check info 'NAT table present; the VPN network in server.conf is not a single /24, so it was not compared'
        return 0
    fi
    # A file that is already right only needs loading; otherwise the installer writes it again.
    reinstall="sudo bash -c 'curl -fsSL https://github.com/$DARBAN_REPO/releases/download/v$DARBAN_VERSION/get.sh | bash -s -- --version v$DARBAN_VERSION'"
    if [[ -f $nat ]] && grep -Fq "ip saddr $net/24 ip daddr 169.254.0.0/16 drop" "$nat" && grep -Fq "ip saddr $net/24 oifname" "$nat"; then
        fix='sudo systemctl restart darban-nat.service'
    else
        fix=$reinstall
    fi
    if ! darban_live_nat_ok "$net"; then
        check bad "NAT does not match the VPN network $net/24 of server.conf, so clients cannot reach the internet through the VPN $S_ARROW $fix"
    else
        # The rule can be right for the network and still send traffic out through the wrong interface.
        live_iface=$(nft list chain ip darban postrouting 2>/dev/null | grep -F "ip saddr $net/24 oifname " | darban_nat_iface)
        route_iface=$(darban_default_iface)
        if [[ -n $live_iface ]] && ! ip link show dev "$live_iface" >/dev/null 2>&1; then
            check bad "NAT sends VPN traffic out through $(safe_text "$live_iface"), which this server no longer has, so clients cannot reach the internet through the VPN $S_ARROW $reinstall"
        elif [[ $live_iface =~ ^[A-Za-z0-9_.@-]+$ && $route_iface =~ ^[A-Za-z0-9_.@-]+$ && $live_iface != "$route_iface" ]]; then
            check warn "NAT sends VPN traffic out through $(safe_text "$live_iface"), but the default route uses $(safe_text "$route_iface"). If that is not on purpose $S_ARROW sudo sed -i 's/oifname \"$live_iface\"/oifname \"$route_iface\"/' $nat && sudo systemctl restart darban-nat.service"
        else
            check ok "NAT for the VPN network $net/24 present"
        fi
    fi
    if darban_live_isolation_ok "$net"; then
        check ok 'VPN clients are kept apart, and away from the cloud metadata service'
    else
        check bad "VPN clients may reach each other, or the cloud metadata service $S_ARROW $fix"
    fi
    if darban_live_mss_ok "$net"; then
        check ok "TCP MSS for VPN traffic is limited to $DARBAN_MSS in both directions"
    else
        check warn "The TCP MSS rule for VPN traffic is missing or different; on some networks websites may not load $S_ARROW $reinstall"
    fi
}
health() {
    local version state enabled dco port e crl_err host resolved next last value issue exports pending
    if [[ -n $SERVER_PROBLEM ]]; then
        group 'Server'
        check bad "$SERVER_PROBLEM"
        # The checks below report what they cannot read, so raw errors from missing files add nothing.
        exec 2>/dev/null
    fi
    group 'OpenVPN'
    version=$(openvpn --version 2>/dev/null | awk 'NR==1 {print $1, $2}' || true)
    if [[ -n $version ]]; then check info "$version"; else check warn 'openvpn binary not found in PATH'; fi
    state=$(systemctl is-active "$DARBAN_UNIT" 2>/dev/null || true)
    enabled=$(systemctl is-enabled "$DARBAN_UNIT" 2>/dev/null || true)
    if [[ $state == active ]]; then check ok "Service active (start at boot: ${enabled:-unknown})"; else check bad "Service ${state:-unknown} ($DARBAN_UNIT)"; fi
    if port=$(server_port); then
        if port_listening "$port"; then check ok "Listening on UDP $port"; else check bad "Nothing listening on UDP $port"; fi
    else
        check bad 'server.conf has no single numeric port directive'
    fi
    if [[ -d /sys/module/ovpn ]]; then dco=ovpn; elif [[ -d /sys/module/ovpn_dco_v2 ]]; then dco=ovpn_dco_v2; else dco=''; fi
    check info "DCO kernel module: ${dco:-not loaded}"
    if server_tls_ok; then check ok 'tls-crypt key matches what profiles embed'; else check bad "server.conf tls-crypt does not use $TLS_KEY"; fi
    if value=$(server_data_ciphers); then check info "Data ciphers: $value"; else check bad 'data-ciphers is repeated or malformed'; fi
    if mgmt_available; then check ok 'Management interface: single-client disconnect available'; else check info 'Management interface: not configured (revocation offers a full restart instead)'; fi

    group 'Certificates'
    if e=$(cert_end_epoch "$DARBAN_PKI/ca.crt"); then check_expiry 'CA certificate' "$e"; else check bad 'CA certificate unreadable'; fi
    if e=$(darban_server_cert_pem | openssl x509 -noout -enddate 2>/dev/null) && e=$(date -u -d "${e#notAfter=}" +%s); then
        check_expiry 'Server certificate' "$e"
    else
        check bad 'Server certificate unreadable'
    fi

    group 'Revocation (CRL)'
    if ! darban_crl_configured; then
        check bad "server.conf has no single 'crl-verify $DARBAN_CRL'"
    elif crl_err=$(C_RED='' C_RESET='' darban_verify_crl "$DARBAN_CRL" 2>&1) && e=$(darban_crl_expiry_epoch "$DARBAN_CRL"); then
        check ok "Published CRL valid and complete; next update $(describe_expiry "$e")"
    else
        check bad "Published CRL problem: ${crl_err##*ERROR: } $S_ARROW Maintenance $S_CRUMB 2"
    fi
    pending=$(revocation_pending_names 2>/dev/null | join_lines) || pending=''
    if [[ -n $pending ]]; then check bad "Revoked but NOT blocked yet: $(safe_text "$pending") $S_ARROW Maintenance $S_CRUMB 2"; fi
    pending=$(revoked_with_profile 2>/dev/null | join_lines) || pending=''
    if [[ -n $pending ]]; then check warn "Revocation unfinished, profile still on server: $(safe_text "$pending") $S_ARROW Maintenance $S_CRUMB 2"; fi
    if systemctl is-active --quiet darban-crl.timer 2>/dev/null; then
        next=$(systemctl show -p NextElapseUSecRealtime --value darban-crl.timer 2>/dev/null || true)
        check ok "Daily renewal timer active${next:+; next run $next}"
    else
        check bad 'Daily renewal timer (darban-crl.timer) is not active'
    fi
    last=$(systemctl show -p Result --value darban-crl.service 2>/dev/null || true)
    if systemctl is-failed --quiet darban-crl.service 2>/dev/null; then
        check bad "Last renewal run FAILED $S_ARROW journalctl -u darban-crl.service"
    else
        check info "Last renewal run: ${last:-unknown}"
    fi

    group 'Network (read-only)'
    value=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || true)
    case $value in
        1) check ok 'IPv4 forwarding enabled' ;;
        0) check bad 'IPv4 forwarding disabled: VPN clients have no internet access' ;;
        *) check info 'IPv4 forwarding: unknown' ;;
    esac
    # ufw can be turned on long after the setup, and then it quietly blocks the VPN.
    if [[ -n ${port:-} ]] && command -v ufw >/dev/null && value=$(ufw status 2>/dev/null) && [[ $value == *'Status: active'* ]]; then
        # Only an ALLOW rule counts: a DENY rule for the same port, or tun0 named in another rule, is not one.
        if ! grep -Eq "^$port(/udp)?[[:space:]]+ALLOW[[:space:]]" <<<"$value"; then
            check bad "ufw is active and blocks UDP $port $S_ARROW sudo ufw allow $port/udp"
        elif ! grep -Eq '[[:space:]]ALLOW FWD[[:space:]].*[[:space:]]on tun0([[:space:]]|$)' <<<"$value"; then
            check bad "ufw is active and blocks forwarding from the VPN $S_ARROW sudo ufw route allow in on tun0 out on $(ip -4 route show default 2>/dev/null | awk '{for (i=1; i<NF; i++) if ($i=="dev") {print $(i+1); exit}}')"
        else
            check ok 'ufw allows the VPN'
        fi
    fi
    network_rules_health

    group 'Profiles & downloads'
    host=$(domain)
    if valid_domain "$host"; then
        resolved=$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1 {print $1}' || true)
        if [[ -n $resolved ]]; then check ok "Server address $host $S_ARROW $resolved"; else check warn "Server address $host does not resolve to IPv4"; fi
    else
        check bad "Server address not set $S_ARROW Settings $S_CRUMB 1"
    fi
    if [[ -n $DOWNLOAD_SSH_HOST ]]; then check ok "Download endpoint $DOWNLOAD_SSH_USER@$DOWNLOAD_SSH_HOST:$DOWNLOAD_SSH_PORT"; fi
    for issue in "${CONFIG_ISSUES[@]}"; do check warn "$issue"; done
    exports=$(find "$OUT_DIR" -maxdepth 1 -type f -name '*.ovpn' 2>/dev/null | wc -l)
    if (( exports > 0 )); then
        check info "$exports profile(s) stored on the server $S_ARROW delete them after download (menu 6)"
    else
        check ok 'No profiles left on the server'
    fi
    # The exit status tells a script or a monitor the same thing the checklist tells a person.
    (( HEALTH_BAD == 0 ))
}

# ---------- screens ----------
title_bar() {
    printf '%s Darban OVPN v%s%s%s\n' "$C_TITLE" "$DARBAN_VERSION" "${1:+ $S_CRUMB $1}" "$C_RESET"
    hr
}
status_block() {
    local host port state endpoint e valid revoked expired soon clients alert pending leftovers
    host=$(domain)
    port=$(server_port 2>/dev/null || printf '?')
    state=$(systemctl is-active "$DARBAN_UNIT" 2>/dev/null || true)
    if [[ $state == active ]]; then state="$C_GREEN$S_DOT active$C_RESET"; else state="$C_RED$S_DOT ${state:-not running}$C_RESET"; fi
    if valid_domain "$host"; then
        endpoint="$host:$port/UDP"
    else
        endpoint="${C_YELLOW}address not set $S_ARROW Settings $S_CRUMB 1$C_RESET (port $port/UDP)"
    fi
    kv Server "$state $S_SEP $endpoint"
    if { darban_crl_configured && darban_verify_crl "$DARBAN_CRL"; } >/dev/null 2>&1 && e=$(darban_crl_expiry_epoch "$DARBAN_CRL"); then
        kv Blocklist "$C_GREEN$S_OK$C_RESET valid $S_SEP $(days_until "$e") days left"
    else
        kv Blocklist "$C_RED$S_BAD problem$C_RESET $S_ARROW details: Maintenance $S_CRUMB 1, repair: Maintenance $S_CRUMB 2"
    fi
    pending=$(revocation_pending_names 2>/dev/null | join_lines) || pending=''
    leftovers=$(revoked_with_profile 2>/dev/null | join_lines) || leftovers=''
    read -r valid revoked expired soon < <(client_stats)
    clients="$valid valid $S_SEP $revoked revoked"
    if (( expired > 0 )); then clients+=" $S_SEP $expired expired"; fi
    if (( soon > 0 )); then clients+=" $S_SEP $C_YELLOW$soon expiring soon$C_RESET"; fi
    if mgmt_available && e=$(connected_rows 2>/dev/null) && [[ -n $e ]]; then clients+=" $S_SEP $(wc -l <<<"$e") connected"; fi
    kv Clients "$clients"
    # Alerts live in the header so clearing the screen can never hide them.
    {
        if e=$(available_update) && [[ -n $e ]]; then printf '%s\n' "Update available: v$e $S_ARROW Setup $S_CRUMB 2"; fi
        if [[ -n $pending ]]; then printf '%s\n' "Revoked but NOT blocked yet: $(safe_text "$pending") $S_ARROW Maintenance $S_CRUMB 2"; fi
        if [[ -n $leftovers ]]; then printf '%s\n' "Revocation unfinished, profile still on server: $(safe_text "$leftovers") $S_ARROW Maintenance $S_CRUMB 2"; fi
        if systemctl is-failed --quiet darban-crl.service 2>/dev/null; then printf '%s\n' "Last automatic CRL run FAILED $S_ARROW Maintenance $S_CRUMB 1"; fi
        if ! systemctl is-active --quiet darban-crl.timer 2>/dev/null; then printf '%s\n' "CRL renewal timer is not active $S_ARROW Maintenance $S_CRUMB 1"; fi
        if e=$(cert_end_epoch "$DARBAN_PKI/ca.crt") && (( $(days_until "$e") <= EXPIRY_WARN_DAYS )); then printf '%s\n' "CA certificate expires $(date -u -d "@$e" +%Y-%m-%d)"; fi
        if e=$(darban_server_cert_pem | openssl x509 -noout -enddate 2>/dev/null) && e=$(date -u -d "${e#notAfter=}" +%s) && (( $(days_until "$e") <= EXPIRY_WARN_DAYS )); then printf '%s\n' "Server certificate expires $(date -u -d "@$e" +%Y-%m-%d); it is not renewed automatically"; fi
        printf '%s\n' "${CONFIG_ISSUES[@]}"
    } | while IFS= read -r alert; do
        if [[ -n $alert ]]; then printf '  %s%s %s%s\n' "$C_YELLOW" "$S_WARN" "$(with_action "$alert")" "$C_RESET"; fi
    done
}
menu_item() {
    # menu_item <key> <label> [danger]: a key to press, and its label, red when it cannot be undone.
    local color=''
    if [[ ${3:-} == danger ]]; then color=$C_DANGER; fi
    printf '   %s%2s%s  %s%s%s\n' "$C_KEY" "$1" "$C_RESET" "$color" "$2" "$C_RESET" || true
}
menu_group() { printf ' %s%s%s\n' "$C_GROUP" "$1" "$C_RESET" || true; }
draw_main() {
    # Ordered by use: creating a client comes first, and revoking, which cannot be undone, ends its group.
    clear_screen
    title_bar
    status_block
    hr
    menu_group CLIENTS
    menu_item 1 'Create client'
    menu_item 2 'List clients'
    menu_item 3 'Connected now'
    menu_item 4 'Revoke client (permanent)' danger
    menu_group SHARING
    menu_item 5 'Share a profile'
    menu_item 6 'Waiting to be picked up (links and files)'
    menu_group SERVER
    menu_item 7 'Settings'
    menu_item 8 'Maintenance'
    menu_item 9 'Setup (update, uninstall, remove all)'
    menu_item 0 'Exit'
    hr
    printf ' %sInside an action, an empty answer or Ctrl+C cancels.%s\n' "$C_HINT" "$C_RESET"
    printf ' %s%s %s %s%s\n' "$C_HINT" "${DARBAN_URL#https://}" "$S_SEP" "$DARBAN_EMAIL" "$C_RESET"
}
draw_settings() {
    local host port
    host=$(domain)
    port=$(server_port 2>/dev/null || printf '?')
    clear_screen
    title_bar Settings
    menu_group SERVER
    menu_item 1 "$(printf '%-24s %s' 'Server address' "${host:-not set}")"
    menu_item 2 "$(printf '%-24s %s' 'OpenVPN UDP port' "$port")"
    menu_group LINKS
    menu_item 3 "$(printf '%-24s %s' 'Link lifetime' "$(hours_label "$(link_hours)")")"
    menu_item 4 "$(printf '%-24s %s' 'Link port' "$(link_port_summary)")"
    menu_item 5 "$(printf '%-24s %s' 'Link certificate' "$(link_cert_summary | cut -d, -f1)")"
    menu_group MORE
    menu_item 6 'Advanced'
    menu_item 0 'Back'
    hr
}
draw_advanced() {
    local network routing dns ciphers keepalive verb download days
    network=$(awk '$1=="server" {print $2 "/24"; exit}' "$DARBAN_SERVER_CONF")
    if conf_full_tunnel; then routing='full tunnel'; else routing='split tunnel'; fi
    dns=$(conf_dns)
    ciphers=$(conf_value data-ciphers)
    keepalive=$(conf_value keepalive)
    verb=$(conf_value verb)
    download='not set'
    if [[ -n $DOWNLOAD_SSH_HOST ]]; then download=$DOWNLOAD_SSH_USER@$DOWNLOAD_SSH_HOST:$DOWNLOAD_SSH_PORT; fi
    days=${CLIENT_CERT_DAYS:-Easy-RSA default}
    clear_screen
    title_bar "Settings $S_CRUMB Advanced"
    menu_group VPN
    menu_item 1 "$(printf '%-24s %s' 'Traffic routing' "$routing")"
    menu_item 2 "$(printf '%-24s %s' 'DNS for clients' "${dns:-none pushed}")"
    menu_item 3 "$(printf '%-24s %s' 'VPN network' "${network:-not set}")"
    menu_item 4 "$(printf '%-24s %s' 'Data ciphers' "${ciphers:-OpenVPN default}")"
    menu_item 5 "$(printf '%-24s %s' 'Keepalive' "${keepalive:-not set}")"
    menu_item 6 "$(printf '%-24s %s' 'Log detail' "${verb:-OpenVPN default}")"
    menu_group CLIENTS
    menu_item 7 "$(printf '%-24s %s' 'New client lifetime' "$days")"
    menu_item 8 "$(printf '%-24s %s' 'Download access' "$download")"
    menu_item 0 'Back'
    hr
    printf ' %sItems 1-6 restart OpenVPN; a change that fails is rolled back.%s\n' "$C_DIM" "$C_RESET" || true
}
advanced_menu() {
    local redraw=1
    while :; do
        if (( redraw )); then draw_advanced || true; fi
        redraw=1
        ask 'Choose [0-8, Enter = back]: ' || return 0
        case $REPLY in
            1) menu_action 'Traffic routing' set_routing ;;
            2) menu_action 'DNS for clients' set_dns ;;
            3) menu_action 'VPN network' set_vpn_network ;;
            4) menu_action 'Data ciphers' set_ciphers ;;
            5) menu_action 'Keepalive' set_keepalive ;;
            6) menu_action 'Log detail' set_verb ;;
            7) menu_action 'New client lifetime' set_client_days ;;
            8) menu_action 'Download access' set_download_access ;;
            0|'') return 0 ;;
            *) warn "Unknown option \"$REPLY\". Enter a number from 0 to 8."; redraw=0 ;;
        esac
    done
}
settings_menu() {
    local redraw=1
    while :; do
        if (( redraw )); then draw_settings || true; fi
        redraw=1
        ask 'Choose [0-6, Enter = back]: ' || return 0
        case $REPLY in
            1) menu_action 'Change server address' set_domain ;;
            2) menu_action 'Change OpenVPN UDP port' change_port ;;
            3) menu_action 'Link lifetime' set_link_hours ;;
            4) menu_action 'Link port' set_link_port ;;
            5) menu_action 'Link certificate' change_link_cert ;;
            6) advanced_menu ;;
            0|'') return 0 ;;
            *) warn "Unknown option \"$REPLY\". Enter a number from 0 to 6."; redraw=0 ;;
        esac
    done
}
draw_maintenance() {
    clear_screen
    title_bar Maintenance
    menu_item 1 'Diagnostics (read-only)'
    menu_item 2 'Repair CRL / finish a revocation'
    menu_item 3 'Restart OpenVPN'
    menu_item 0 'Back'
    hr
}
maintenance_menu() {
    local redraw=1
    while :; do
        if (( redraw )); then draw_maintenance || true; fi
        redraw=1
        ask 'Choose [0-3, Enter = back]: ' || return 0
        case $REPLY in
            1) menu_action 'Diagnostics' health ;;
            2) menu_action 'Repair CRL' repair_crl ;;
            3) menu_action 'Restart OpenVPN' restart_openvpn ;;
            0|'') return 0 ;;
            *) warn "Unknown option \"$REPLY\". Enter a number from 0 to 3."; redraw=0 ;;
        esac
    done
}
draw_setup() {
    clear_screen
    title_bar Setup
    menu_item 1 'About'
    menu_item 2 "$(printf '%-24s %s' 'Check for updates' "installed: v$DARBAN_VERSION")"
    menu_item 3 "$(printf '%-24s %s' 'Daily update notice' "$UPDATE_CHECK")"
    menu_item 4 'Restore previous version'
    menu_item 5 'Uninstall this tool only' danger
    menu_item 6 'Remove everything (tool, OpenVPN, CA)' danger
    menu_item 0 'Back'
    hr
}
setup_menu() {
    local redraw=1
    while :; do
        if (( redraw )); then draw_setup || true; fi
        redraw=1
        ask 'Choose [0-6, Enter = back]: ' || return 0
        case $REPLY in
            # Unlocked: the installer's own CRL check takes the same lock and would wait for this one.
            1) menu_action 'About' about_text ;;
            2) menu_action 'Check for updates' update_tool ;;
            3) run_action toggle_update_notice; load_config ;;
            4) menu_action 'Restore previous version' restore_previous ;;
            5) menu_action 'Uninstall this tool' uninstall_tool ;;
            6) menu_action 'Remove everything' remove_everything ;;
            0|'') return 0 ;;
            *) warn "Unknown option \"$REPLY\". Enter a number from 0 to 6."; redraw=0 ;;
        esac
    done
}
program_exit() {
    # Said on the way out, so nobody has to look for how to come back.
    printf '\nTo open this menu again, type: %s\n' "$(cmd sudo darban)" || true
    exit 0
}
draw_recovery() {
    clear_screen
    title_bar
    fail "This server cannot be managed right now: $SERVER_PROBLEM"
    hr
    menu_item 1 'Diagnostics (read-only)'
    menu_item 2 'Check for updates'
    menu_item 3 'Uninstall this tool only' danger
    menu_item 4 'Remove everything (tool, OpenVPN, CA)' danger
    menu_item 0 'Exit'
    hr
    printf ' %sThe other options return when this is fixed.%s\n' "$C_DIM" "$C_RESET" || true
}
menu_traps() {
    # A trapped (not default) SIGINT lets Ctrl+C cancel only the running action. Outside an action it exits
    # from inside the trap: bash resumes an interrupted read afterwards, so a flag would wait for Enter.
    trap 'if (( ACTION_RUNNING )); then DARBAN_INT=1; else program_exit; fi' INT
    trap ui_restore EXIT
}
recovery_menu() {
    local redraw=1
    menu_traps
    while :; do
        if (( redraw )); then draw_recovery || true; fi
        redraw=1
        ask 'Choose [0-4]: ' || program_exit
        case $REPLY in
            1) menu_action 'Diagnostics' health ;;
            2) menu_action 'Check for updates' update_tool ;;
            3) menu_action 'Uninstall this tool' uninstall_tool ;;
            4) menu_action 'Remove everything' remove_everything ;;
            0) program_exit ;;
            '') redraw=0 ;;
            *) warn "Unknown option \"$REPLY\". Enter a number from 0 to 4."; redraw=0 ;;
        esac
    done
}
needs_reboot() {
    # A kernel was added for the ovpn module, and the system is not running one with it yet.
    grep -q '^kernel ' "$CONFIG_DIR/.server-setup-started" 2>/dev/null && ! modinfo -k "$(uname -r)" ovpn >/dev/null 2>&1
}
next_steps() {
    local port
    port=$(server_port 2>/dev/null || printf '?')
    say
    section 'Your VPN server is ready'
    kv Address "$(domain)"
    kv Port "$port/UDP"
    say
    printf '%sDo this now:%s\n' "$C_BOLD" "$C_RESET" || true
    bullet "Open UDP $port in your server provider's firewall. This tool cannot see or change it."
    if needs_reboot; then
        say
        printf '%sLater:%s\n' "$C_BOLD" "$C_RESET" || true
        bullet "Reboot once when convenient, for a faster VPN: $(cmd sudo reboot)"
    fi
    if iptables -S FORWARD 2>/dev/null | grep -q '^-P FORWARD DROP' && ! command -v ufw >/dev/null; then
        say
        warn 'The iptables FORWARD policy is DROP, for example because of Docker. Clients may connect but have no internet until it allows tun0.'
    fi
    say
    printf '%sTo manage this server at any time:%s\n' "$C_BOLD" "$C_RESET" || true
    bullet "Connect over SSH, type $(cmd sudo darban) and press Enter. The menu opens, where clients are created, shared and revoked."
    say
}
welcome() {
    # The end of a new setup: what is left to do, and one Enter to the first client.
    next_steps
    if (( ! UI_TTY )); then say 'Next, create a client: sudo darban'; return 0; fi
    if confirm_choice 'Create your first client now?' 'Not now' 'Create a client' normal '' 2; then
        say
        run_action create_client client1
    fi
    main_menu
}
first_run() {
    # Profiles cannot be built without a hostname, so guide a fresh install there first.
    valid_domain "$(domain)" && return 0
    (( UI_TTY )) || return 0
    clear_screen
    title_bar
    info 'Welcome! The server address is not set yet; client profiles need it.'
    if confirm_choice 'Set the server address now?' 'Not now' 'Set it now' normal '' 2; then
        menu_action 'Change server address' set_domain
    fi
}
main_menu() {
    local redraw=1
    menu_traps
    start_update_check
    first_run
    while :; do
        if (( redraw )); then draw_main || true; fi
        redraw=1
        ask 'Choose [0-9]: ' || program_exit
        case $REPLY in
            1) menu_action 'Create client' create_client ;;
            2) menu_action 'Clients' list_menu ;;
            3) menu_action 'Connected now' connected_clients ;;
            4) menu_action 'Revoke client (permanent)' revoke_client ;;
            5) menu_action 'Share a profile' share_profile ;;
            6) menu_action 'Waiting to be picked up' pending_shares ;;
            7) settings_menu ;;
            8) maintenance_menu ;;
            9) setup_menu ;;
            0) program_exit ;;
            '') redraw=0 ;;
            *) warn "Unknown option \"$REPLY\". Enter a number from 0 to 9."; redraw=0 ;;
        esac
    done
}
usage() {
    cat <<EOF
Darban OVPN v$DARBAN_VERSION

Usage: darban [--no-clear] [COMMAND]

Commands:
  (none)     interactive menu
  list       print the client table; --all includes revoked clients
  status     print the diagnostics checklist
  repair-crl publish a fresh CRL and finish an interrupted revocation
  connected  list the clients connected right now
  update     check for a new release and install it
  welcome    show the next steps of a new server
  about      show the version, project address and contact
  uninstall  remove this tool; OpenVPN, the PKI and the CRL are kept
  remove-all remove this tool, OpenVPN, the CA and all profiles (only after server-setup)
  version    print the version
  help       show this help

Options:
  --no-clear never clear the screen

Environment: NO_COLOR=1 disables colors. Actions are logged: journalctl -t darban

Project: $DARBAN_URL
Contact: $DARBAN_EMAIL
EOF
}
main() {
    local cmd=''
    while (( $# )); do
        case $1 in
            --no-clear) UI_CLEAR=0 ;;
            --all) LIST_ALL=1 ;;
            -h|--help|help) usage; exit 0 ;;
            -V|--version|version) printf '%s\n' "$DARBAN_VERSION"; exit 0 ;;
            about) about_text; exit 0 ;;
            list|status|repair-crl|connected|update|uninstall|remove-all|welcome) [[ -z $cmd ]] || { usage >&2; exit 2; }; cmd=$1 ;;
            *) printf 'Unknown argument: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
        esac
        shift
    done
    if (( LIST_ALL )) && [[ $cmd != list ]]; then printf -- '--all only works with list.\n\n' >&2; usage >&2; exit 2; fi
    ui_init
    setup
    # Diagnostics, updates and removal must work on a broken server; these two cannot.
    if [[ -n $SERVER_PROBLEM ]] && [[ $cmd == list || $cmd == repair-crl || $cmd == connected || $cmd == welcome ]]; then
        fail "$SERVER_PROBLEM"
        info 'Details: sudo darban status'
        exit 1
    fi
    case $cmd in
        list) run_action list_clients; exit "$ACTION_RC" ;;
        status) run_action health; exit "$ACTION_RC" ;;
        repair-crl) run_action repair_crl; exit "$ACTION_RC" ;;
        connected) run_action connected_clients; exit "$ACTION_RC" ;;
        welcome) welcome; exit 0 ;;
        update) run_action update_tool; exit "$ACTION_RC" ;;
        uninstall) run_action uninstall_tool; exit "$ACTION_RC" ;;
        remove-all) run_action remove_everything; exit "$ACTION_RC" ;;
    esac
    if [[ -n $SERVER_PROBLEM ]]; then recovery_menu; fi
    main_menu
}
main "$@"
