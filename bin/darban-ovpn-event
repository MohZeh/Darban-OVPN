#!/bin/bash
# Darban OVPN connection events. OpenVPN runs this as the user server.conf names, nobody, when a client connects
# (client-connect) and when the server ends a session (client-disconnect). It writes one line into a queue in a
# tmpfs of its own, and a root job, "darban events", reads it there.
#
# It always exits 0, so it never refuses or holds up a connection: no lock, no network, no waiting, and one
# program besides bash, the mv. Whatever it cannot check or write is dropped: the queue missing or not mounted,
# full, read-only, or a value from OpenVPN that does not look right. Installed as /usr/local/libexec/darban-ovpn-event,
# outside the tool's own folder, so removing the tool never leaves server.conf naming a script that is gone.
#
# At a connection it also gives the client the routes of Settings > Blocked destinations > Iranian sites outside
# the VPN, so its traffic to Iran goes through its own internet. Those lines go into the file OpenVPN names as $1.
queue=/run/darban-events
direct=/etc/openvpn/server/darban-direct.routes
direct_routes() {
    # direct_routes <file OpenVPN reads>: the routes, to a client that can take them. Only root can write the list,
    # and still only lines shaped as one route each are passed on, so nothing else ever reaches a client.
    local version=${IV_VER-} lines line out=''
    # OpenVPN 3, as in OpenVPN Connect, refuses a connection whose options pass 256 KiB before 3.11.1, and the whole
    # list counts more. OpenVPN 2 has no such limit. Any other client gets nothing.
    if [[ $version =~ ^3\.([0-9]{1,3})(\.([0-9]{1,3}))? ]]; then
        (( 10#${BASH_REMATCH[1]} > 11 || (10#${BASH_REMATCH[1]} == 11 && 10#${BASH_REMATCH[3]:-0} >= 1) )) || return 0
    elif [[ ! $version =~ ^2\.[0-9] ]]; then
        return 0
    fi
    mapfile -t lines <"$direct" 2>/dev/null || return 0
    [[ ${lines[0]-} =~ ^#\ darban-direct\ 1\ android=(yes|no)$ ]] || return 0
    if [[ ${BASH_REMATCH[1]} == no && ${IV_PLAT-} == android ]]; then return 0; fi
    for line in "${lines[@]:1}"; do
        [[ $line =~ ^push\ \"route\ [0-9]{1,3}(\.[0-9]{1,3}){3}\ [0-9]{1,3}(\.[0-9]{1,3}){3}\ net_gateway\"$ ]] && out+=$line$'\n'
    done
    printf '%s' "$out" 2>/dev/null >>"$1"
}
if [[ ${script_type-} == client-connect && -n ${1-} && -r $direct ]]; then direct_routes "$1"; fi
# Written last by the job that makes the folders inside the tmpfs: without it, nothing lands on /run itself.
[[ -e $queue/.mounted ]] || exit 0
case ${script_type-} in
    client-connect) kind=connect ;;
    client-disconnect) kind=disconnect ;;
    *) exit 0 ;;
esac
cn=${common_name-}
[[ $cn =~ ^[A-Za-z0-9][A-Za-z0-9._@+-]{0,127}$ ]] || exit 0
ip=${trusted_ip-}
[[ $ip =~ ^[0-9A-Fa-f.:]{2,45}$ ]] || ip=-
# A clock NTP cannot move: the boot and the hundredths of a second since it.
{ read -r boot </proc/sys/kernel/random/boot_id && read -r up _ </proc/uptime; } 2>/dev/null || exit 0
[[ $boot =~ ^[0-9a-f-]{36}$ && $up =~ ^[0-9]{1,10}\.[0-9]{2}$ ]] || exit 0
cs=${up/./}
cs=${cs#"${cs%%[!0]*}"}
cs=${cs:-0}
# The wall clock in microseconds, whatever the decimal sign of the locale, for what the menu shows.
us=${EPOCHREALTIME//[!0-9]/}
[[ $us =~ ^[0-9]{16}$ ]] || exit 0
serial=${tls_serial_hex_0-}
[[ $serial =~ ^[0-9A-Fa-f:]{1,64}$ ]] || serial=-
# Which share the profile came from, when it says so; the client sets it, so it can only narrow what ends.
share=''
if [[ $kind == connect && ${UV_DARBAN_SHARE-} =~ ^[0-9a-f]{16}$ ]]; then share=" $UV_DARBAN_SHARE"; fi
rx=- tx=- duration=- start=-
if [[ $kind == disconnect ]]; then
    [[ ${bytes_received-} =~ ^[0-9]{1,20}$ ]] && rx=$bytes_received
    [[ ${bytes_sent-} =~ ^[0-9]{1,20}$ ]] && tx=$bytes_sent
    [[ ${time_duration-} =~ ^[0-9]{1,10}$ ]] && duration=$time_duration
    # time_unix in a disconnect is when the session began.
    [[ ${time_unix-} =~ ^[0-9]{1,12}$ ]] && start=$time_unix
fi
# A queue nobody reads stops growing here; the count needs no program.
pending=("$queue"/new/*)
(( ${#pending[@]} < 1000 )) || exit 0
id=$boot-$cs-$$-$RANDOM
set -C
printf 'darban-event 1 %s %s %s %s %s %s %s %s %s %s %s%s\n' "$kind" "$cn" "$boot" "$cs" "$us" "$ip" "$serial" "$rx" "$tx" "$duration" "$start" "$share" \
    2>/dev/null >"$queue/tmp/$id" || exit 0
mv -n -- "$queue/tmp/$id" "$queue/new/$id" 2>/dev/null
exit 0
